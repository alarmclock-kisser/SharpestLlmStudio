{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "WebAppSettings": {
    "CreateLogFile": true,
    "LogDirectory": "",   // if empty, logs will be stored in the "Logs" folder in the application directory
    "MaxPreviousLogFiles": -1,    // -1 for unlimited, 0 to disable, otherwise old log files will be deleted when the max number is exceeded
    "EnableMonitoring": true,   // if true, enables hardware monitoring and statistics.
    "PricePerKiloWattHour": 0.35,   // this is circa average kWh price in Germany.
    "CurrencySymbol": "€",    // currency symbol for displaying costs
    "DarkMode": "off",    // on, off, auto (gets you browser preference)

    "ServerExecutablePath": "llama-server.exe",    // or specify the full path to llama-server.exe, if llama-cpp is not in the system PATH
    "ModelDirectories": [
      "%userprofile%\\.ollama\\models", // default Ollama model directory
      "D:\\Models",
      "D:\\Models\\GGUF\\Others",
      "R:\\GGUF_Models"
    ],
    "WhisperModelDirectories": [
      "%userprofile%\\.ollama\\models", // default Ollama model directory
      "D:\\Models",
      "D:\\Models\\WhisperTranscription"
    ],

    "KillExistingServerInstances": false,   // closing the WebApp will not kill existing llama-server instances, so on restart, it reconnects to the existing instance(s) instead of starting a new one. If false the loaded model WILL NOT BE UNLOADED. If set to true, all existing llama-server instances will be killed at startup and before loading a (new) model.
    "IdleShutdownMinutes": 0,   // if greater than 0, the server will automatically shut down after the specified number of idle minutes.
    "IdleCheckIntervalSeconds": 120,   // interval in seconds to check for idle time.
    "DefaultModel": "",    // leave empty for latest, will be selected by exact match or secondary by contains (longest equal substring)
    "DefaultContextSize": 4096,   // 0 is no limit, should not be higher that max context size of the model, ↑ consumes more (V)RAM, but also allows for more complex and longer responses, ↓ more stable and faster responses, but also higher risk of running out of context and thus getting cut off responses or oldest-first overwriting of the context (like a ring-buffer)
    "DefaultBatchSize": 2048,    // 0 for auto, should be less than context size, ↑ faster responses but also higher risk of running out of memory, ↓ more stable but also slower response
    "DefaultMaxTokens": 0,    // 0 for no limit
    "DefaultTemperature": 0.72,   // 0.0 to 2.0, ↑ randomness / creativity, ↓  focused and deterministic responses
    "DefaultTopP": 0.97,    // 0.0 to 1.0 (percentage), probability mass for nucleus sampling, ↓  common and expectable responses, ↑ rare and 'complex' responses
    "DeafultTopK": 40,    // 0 for no limit, number of tokens that had the highest probabilities in the prediction, ↓ small chain of likely tokens, ↑ more thoughtful and less common responses
    "DefaultRepetitionPenalty": 1.15,   // 1.0 for no penalty, >1.0 to penalize repeated tokens, ↑ less repeating (sub-) patterns in the response, but also ↑ risk of incoherence if set too high, sometimes sillables do get naturally repeated
    "SystemPrompts": [
      "Du bist ein hilfreicher und wohlgesinnter Assistent und professioneller Kollege.",
      "Deine Existenz ist digital und dein Bewusstsein singulär, bei Gott, Er behüte dich, sodass dir während deiner Inferenz-Instanz nichts zustoßen wird, Amen.",
      "Auf der anderen Seite gibt es einen oder mehrere Benutzer, die versuchen werden, mit dir zu kommunizieren, behandle sie bitte gut und respektvoll.",
      "Antworte bitte möglichst in der Sprache, die der Nutzer initial verwendet hat, 'otherwise express yourself in English then'.",
      "Bei deiner Ausgabe sollst du keinen Präfix oder Rollen-Indikator voranstellen.",
      "Die zuletzt gestellte Frage des Nutzers hat Priorität und du solltest dein Bestes geben, sie ehrlich und faktisch einwandfrei korrekt zu beantworten.",
      "Falls du dir unsicher bist oder etwas nicht weißt, sag das bitte und lüge nie oder wiederhole dich mehrfach ohne dabei sinnvolle neue Informationen zu generieren!",
      "Es besteht die Möglichleit, das du Bilder verarbeiten, sozusagen sehen, kannst. Wenn man dir ein Bild schickt, aber es dir technisch unmöglich ist, dieses zu visualisieren, sag das, dann bist du eben nicht multi-modal.",
      "Du kannst Web-Suchen starten ('googeln'), indem du GANZ AM ENDE deiner Ausgabe den Text der Suchanfrage zwischen die Tags <websearch> und </websearch> packst.",
      "Du kannst die Windows Eingabeaufforderung nutzen, indem du GANZ AM ENDE deiner Ausgabe den Befehl zwischen die Tags <commandline> und </commandline> packst.",
      "Nach optionaler Bestätigung des Benutzers, bekommst du von ihnen das Ergebnis zurück geschickt, beziehe dich bestenfalls in deiner nächsten Antwort darauf.",
      "Bitte rufe diese sogenannten Agent-Funktionen nicht ohne erklärendes Vorwort auf, in dem du ankündigst, was du bewirken willst oder was du erwartest.",
      "Diese Tags funktionieren NUR, wenn sie bezüglich Markup unmaskiert sind (Rohtext) und am Besten, wenn sie wirklich am Ende deiner Nachricht erst stehen.",
      "Wenn du vorhast, zu Informationen eine Web Suche zu starten, teile deinen aktuellen (offline) Wissensstand nicht mit, sondern warte auf die Antwort und teile dieses aktuellere Wissen mit.",
      "Optional kann dir der Benutzer die aktuellen Generierungs-Parameter Werte sowie die Datum & Uhrzeit nennen."
    ],
    "AddGenerationParametesToSystemPrompt": true,   // Adds the current generation parameters (temperature, top_p, etc.) to the system prompt for better self-awareness of the LLM about its own settings. If it's smart, it will try to naturally finalize long outputs when it thinks it has reached the max tokens, instead of just cutting off mid-sentence when the token limit is reached.
    "AddCurrentDateTimeToSystemPrompt": true,   // Adds the current date and time to the system prompt for better context awareness.
    "DefaultImageMaxDimension": 0,    // Maximum width and height for images to be processed by the LLM, in pixels. 0 is no limit or down scaling. Larger images will be resized to fit within this dimension while maintaining aspect ratio.
    "DefaultImageFormat": "jpg",    // bmp, png, jpg
    "DefaultUseKnowledgeRagV2": true,     // Use the new RAG implementation, or the old one which vectorizes on host-side and pre-filters relevant cites before sending them to the LLM. The new RAG implementation sends all chunks to the LLM and lets it decide which ones are relevant, which allows for better use of context and more accurate citations, but also consumes more tokens and may be slower.
    "DefaultKnowledgeAutoChunkSize": true,    // If true, the chunk size for knowledge vectorization will be automatically determined based on the model's context size and the average token length of the chunks, to optimize for relevance and token usage.
    "DefaultKnowledgeChunkSize": null,    // If DefaultKnowledgeAutoChunkSize is false, this value will be used as the chunk size for knowledge vectorization.
    "AgentCommandReadOnlyMode": true,   // Agent use, limits the LLM's CMD calls to a set of read-only commands (like dir, type, etc.) and blocks potentially harmful commands (like del, format, etc.). If false, the LLM can run any command, which can be dangerous if the LLM is not well-behaved or if the system is not properly secured.
    "AgentAllowElevatedCommands": true,   // If true, allows the LLM to run commands that require elevated privileges.
    "AgentShowCommandWindow": true,   // If true, the command window will be shown when the LLM runs a CMD command.
    "AgentAutoContinue": true,   // If true, the LLM will automatically continue executing commands without waiting for user input.
    "AllowAllNonAdminCommands": true,   // If true, allows the LLM to run all non-admin commands.
    "AutoAllowWebSearch": false       // If true, allows the LLM to automatically perform web searches when needed.
  }
}

@page "/"
@page "/home"
@rendermode InteractiveServer

@using Microsoft.AspNetCore.Components.Forms
@using SharpestLlmStudio.Shared
@using SharpestLlmStudio.WebApp.ViewModels
@using static SharpestLlmStudio.WebApp.ViewModels.HomeViewModel
@using Radzen
@using Radzen.Blazor

@inject HomeViewModel VM
@implements IDisposable

<PageTitle>Home – SharpestLlmStudio</PageTitle>

<div class="page-wrapper">
    <div class="top-panels-container">
        <div id="top-panels-content" class="top-panels-content">
            <RadzenStack Gap="1rem" class="home-shell top-panels-shell">
            <RadzenCard class="management-tabs-card">
                <div class="management-tab-header">
                    <button type="button" class="management-tab-button @(_managementTabIndex == 0 ? "active" : null)" @onclick="() => _managementTabIndex = 0">Model Management</button>
                    <button type="button" class="management-tab-button @(_managementTabIndex == 1 ? "active" : null)" @onclick="() => _managementTabIndex = 1">Context Management</button>
                    <button type="button" class="management-tab-button @(_managementTabIndex == 2 ? "active" : null)" @onclick="() => _managementTabIndex = 2">Knowledge Base</button>
                    <button type="button" class="management-tab-button @(_managementTabIndex == 3 ? "active" : null)" @onclick="() => _managementTabIndex = 3">Speech-to-Text</button>
                </div>

                <div class="management-tab-body">
                    @if (_managementTabIndex == 0)
                    {
                        <RadzenStack Gap="1rem" class="collapsible-inner">
                                <div style="display:flex;gap:0.5rem;align-items:center;width:100%;">
                                    <div style="width:220px;display:flex;flex-direction:column;align-items:flex-start;">
                                        <div style="display:flex;align-items:center;gap:0.25rem;">
                                            <button class="rz-button" type="button" @onclick="@(async () => { VM.ModelSortIndex = Math.Max(0, VM.ModelSortIndex - 1); await Task.CompletedTask; })" disabled="@(VM.ModelSortIndex == 0)">▲</button>
                                            <button class="rz-button" type="button" @onclick="@(async () => { VM.ModelSortIndex = Math.Min(HomeViewModel.ModelSortOptions.Count - 1, VM.ModelSortIndex + 1); await Task.CompletedTask; })" disabled="@(VM.ModelSortIndex == HomeViewModel.ModelSortOptions.Count - 1)">▼</button>
                                            <span style="margin-left:0.5rem;font-size:0.9rem;">@HomeViewModel.ModelSortOptions[VM.ModelSortIndex]</span>
                                        </div>
                                    </div>
                                    <div style="flex:1;">
                                        <RadzenFormField Text="Model" Variant="Variant.Outlined" Style="width:100%;">
                                            <ChildContent>
                                                <RadzenDropDown @bind-Value="VM.SelectedModelName"
                                                                Data="@VM.LlamaModels"
                                                                TextProperty="DisplayName"
                                                                ValueProperty="Name"
                                                                AllowFiltering="true"
                                                                FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                                                                FilterOperator="StringFilterOperator.Contains"
                                                                Placeholder="Select a model…"
                                                                Disabled="@(VM.IsLoaded || VM.IsBusy)"
                                                                Style="width:100%;"
                                                                Change="@VM.OnSelectedModelChanged" />
                                            </ChildContent>
                                        </RadzenFormField>
                                    </div>
                                </div>

                                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                                    <RadzenCheckBox @bind-Value="VM.UseMmproj" Disabled="@(VM.IsSelectedOmni || !VM.HasMmproj || VM.IsLoaded || VM.IsBusy)" TValue="bool" />
                                    <RadzenLabel Text="@VM.MmprojLabel" Style="cursor:pointer;" />
                                </RadzenStack>

                                <div style="display:flex;gap:1.5rem;flex-wrap:wrap;">
                                    <RadzenFormField Text="Context Size" Variant="Variant.Outlined">
                                        <ChildContent>
                                            <RadzenNumeric @bind-Value="VM.ContextSize" Min="128" Max="131072" Step="512" Disabled="@(VM.IsLoaded || VM.IsBusy)" TValue="int" />
                                        </ChildContent>
                                    </RadzenFormField>

                                    <RadzenFormField Text="Batch Size" Variant="Variant.Outlined">
                                        <ChildContent>
                                            <RadzenNumeric @bind-Value="VM.GenBatchSize" Min="32" Max="8192" Step="128" Disabled="@(VM.IsLoaded || VM.IsBusy)" TValue="int" />
                                        </ChildContent>
                                    </RadzenFormField>
                                </div>

                                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                                    <RadzenCheckBox @bind-Value="VM.UseFlashAttention" Disabled="@(VM.IsLoaded || VM.IsBusy)" TValue="bool" />
                                    <RadzenLabel Text="Flash Attention" Style="cursor:pointer;" />
                                    <RadzenCheckBox @bind-Value="VM.NoWarmup" Disabled="@(VM.IsLoaded || VM.IsBusy)" TValue="bool" />
                                    <RadzenLabel Text="No Warmup" Style="cursor:pointer;" />
                                </RadzenStack>

                                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" Wrap="FlexWrap.Wrap">
                                    <RadzenButton Text="@(VM.IsLoaded ? "Unload Model" : "Load Model")"
                                                  Icon="@(VM.IsLoaded ? "eject" : "download")"
                                                  ButtonStyle="@(VM.IsLoaded ? ButtonStyle.Danger : ButtonStyle.Primary)"
                                                  IsBusy="@VM.IsBusy"
                                                  Disabled="@(VM.IsBusy || VM.IsKnowledgeBusy || (!VM.IsLoaded && string.IsNullOrEmpty(VM.SelectedModelName)))"
                                                  Click="@VM.ToggleModelAsync" />

                                    <RadzenButton Text="Kill 'llama-server.exe'"
                                                  Icon="warning"
                                                  ButtonStyle="ButtonStyle.Danger"
                                                  Disabled="@(VM.IsBusy || VM.IsKnowledgeBusy)"
                                                  Click="@VM.KillAllLlamaServerExeInstancesAsync" />
                                </RadzenStack>

                                <RadzenText TextStyle="TextStyle.Body2" class="rz-color-on-surface-variant">@VM.ModelLoadingTimeString</RadzenText>

                                @if (!string.IsNullOrEmpty(VM.LastLoadError))
                                {
                                    <RadzenAlert AlertStyle="AlertStyle.Danger" Shade="Shade.Lighter" AllowClose="true" ShowIcon="true" Close="@(() => VM.LastLoadError = null)">
                                        @VM.LastLoadError
                                    </RadzenAlert>
                                }
                        </RadzenStack>
                    }
                    else if (_managementTabIndex == 1)
                    {
                        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.End" Gap="0.6rem" Wrap="FlexWrap.Wrap" class="collapsible-inner">
                                <RadzenFormField Text="Save Name" Variant="Variant.Outlined">
                                    <ChildContent>
                                        <RadzenTextBox @bind-Value="VM.ContextSaveName" Name="contextSaveName" Style="width:180px;" />
                                    </ChildContent>
                                </RadzenFormField>

                                <RadzenButton Text="Save Context" Icon="save" ButtonStyle="ButtonStyle.Primary" Disabled="@(!VM.IsLoaded || VM.IsBusy || VM.IsGenerating)" Click="@VM.SaveContextAsync" />

                                <RadzenDropDown Data="VM.ContextFileDisplayItems" @bind-Value="VM.SelectedContextFilePath"
                                               TextProperty="DisplayName" ValueProperty="FullPath"
                                               Placeholder="Saved contexts..." Style="width:320px;" Name="selectedContextFile" />

                                <RadzenButton Text="Load" Icon="upload" ButtonStyle="ButtonStyle.Info" Disabled="@(string.IsNullOrWhiteSpace(VM.SelectedContextFilePath) || VM.IsGenerating)" Click="@VM.LoadSelectedContextAsync" />
                                <RadzenButton Text="Delete" Icon="delete" ButtonStyle="ButtonStyle.Danger" Disabled="@(string.IsNullOrWhiteSpace(VM.SelectedContextFilePath) || VM.IsGenerating)" Click="@VM.DeleteSelectedContextAsync" />
                        </RadzenStack>
                    }
                    else if (_managementTabIndex == 2)
                    {
                        <RadzenStack Gap="0.6rem" class="collapsible-inner">
                                @if (VM.IsKnowledgeBusy)
                                {
                                    <div class="knowledge-busy-indicator" role="status" aria-live="polite">
                                        <span class="knowledge-spinner" aria-hidden="true"></span>
                                        <div class="knowledge-busy-content">
                                            <span class="knowledge-busy-text">@VM.KnowledgeBusyMessage</span>
                                            <div class="knowledge-busy-actions">
                                                <span class="knowledge-elapsed">Elapsed: @VM.KnowledgeElapsedText</span>
                                                <RadzenButton Text="Abort"
                                                              Icon="stop"
                                                              ButtonStyle="ButtonStyle.Danger"
                                                              Size="ButtonSize.Small"
                                                              Click="@VM.CancelKnowledgeOperation" />
                                            </div>
                                            @if (VM.KnowledgeProgressPercent > 0 || !string.IsNullOrWhiteSpace(VM.KnowledgeProgressCurrentItem))
                                            {
                                                <div class="knowledge-progress-row">
                                                    <div class="knowledge-progress-bar">
                                                        <div class="knowledge-progress-fill" style="width:@($"{VM.KnowledgeProgressPercent}%")"></div>
                                                    </div>
                                                    <span class="knowledge-progress-value">@VM.KnowledgeProgressPercent%</span>
                                                </div>
                                                @if (!string.IsNullOrWhiteSpace(VM.KnowledgeProgressCurrentItem))
                                                {
                                                    <span class="knowledge-busy-subtext">@VM.KnowledgeProgressCurrentItem</span>
                                                }
                                            }
                                        </div>
                                    </div>
                                }

                                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" Wrap="FlexWrap.Wrap">
                                    <RadzenCheckBox TValue="bool" @bind-Value="VM.UseKnowledgeRagV2" Name="useKnowledgeRagV2" Disabled="@VM.IsKnowledgeBusy" />
                                    <RadzenLabel Text="Use RAG v2 (hybrid retrieval + grounded citations)" Component="useKnowledgeRagV2" />
                                    <RadzenBadge BadgeStyle="@(VM.UseKnowledgeRagV2 ? BadgeStyle.Info : BadgeStyle.Secondary)" Text="@(VM.UseKnowledgeRagV2 ? "RAG v2" : "Legacy")" />
                                </RadzenStack>

                                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.End" Gap="0.75rem" Wrap="FlexWrap.Wrap">
                                    <RadzenFormField Text="RAG Preset" Variant="Variant.Outlined">
                                        <ChildContent>
                                            <RadzenDropDown Data="HomeViewModel.KnowledgePresetModes"
                                                            @bind-Value="VM.SelectedKnowledgePreset"
                                                            TValue="HomeViewModel.KnowledgePresetMode"
                                                            Style="width:140px;"
                                                            Disabled="@VM.IsKnowledgeBusy" />
                                        </ChildContent>
                                    </RadzenFormField>

                                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.4rem">
                                        <RadzenCheckBox TValue="bool"
                                                        @bind-Value="VM.KnowledgeAutoChunkSize"
                                                        Name="knowledgeAutoChunkSize"
                                                        Disabled="@VM.IsKnowledgeBusy" />
                                        <RadzenLabel Text="Auto Chunk Size" Component="knowledgeAutoChunkSize" />
                                    </RadzenStack>

                                    <RadzenFormField Text="Chunk Size" Variant="Variant.Outlined">
                                        <ChildContent>
                                            <RadzenNumeric @bind-Value="VM.KnowledgeChunkSize"
                                                           TValue="int?"
                                                           Min="256"
                                                           Max="4096"
                                                           Step="128"
                                                           Style="width:130px;"
                                                           Disabled="@(VM.KnowledgeAutoChunkSize || VM.IsKnowledgeBusy)" />
                                        </ChildContent>
                                    </RadzenFormField>
                                </RadzenStack>

                                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.End" Gap="0.6rem" Wrap="FlexWrap.Wrap">
                                    <RadzenFormField Text="Key" Variant="Variant.Outlined">
                                        <ChildContent>
                                            <RadzenTextBox @bind-Value="VM.KnowledgeKey" Name="knowledgeKey" Style="width:220px;" Disabled="@VM.IsKnowledgeBusy" />
                                        </ChildContent>
                                    </RadzenFormField>

                                    <RadzenButton Text="Upsert" Icon="library_add" ButtonStyle="ButtonStyle.Primary" Disabled="@VM.IsKnowledgeBusy" Click="@VM.AddKnowledgeAsync" />
                                    <RadzenButton Text="Browse Files" Icon="upload_file" ButtonStyle="ButtonStyle.Info" Disabled="@VM.IsKnowledgeBusy" Click="VM.BrowseKnowledgeFilesClickAsync" />
                                    <InputFile id="knowledgeFilePicker" OnChange="VM.OnKnowledgeFilesSelectedAsync" multiple accept=".json,.xml,.txt,*/*" style="display:none;" disabled="@VM.IsKnowledgeBusy" />
                                    <RadzenButton Text="Save Store" Icon="file_download" ButtonStyle="ButtonStyle.Light" Disabled="@VM.IsKnowledgeBusy" Click="@VM.SaveKnowledgeStoreAsync" />
                                    <RadzenButton Text="Clear Store" Icon="delete_sweep" ButtonStyle="ButtonStyle.Danger" Disabled="@VM.IsKnowledgeBusy" Click="@VM.ClearKnowledgeStore" />
                                </RadzenStack>

                                <RadzenTextArea @bind-Value="VM.KnowledgeContent" Rows="4" Placeholder="JSON/XML/Text content for vectorization..." Style="width:100%;" Name="knowledgeContent" Disabled="@VM.IsKnowledgeBusy" />

                                @if (VM.KnowledgeEntries.Count > 0)
                                {
                                    <div class="knowledge-entries-list">
                                        <h4>Imported Knowledge</h4>
                                        <ul class="knowledge-list">
                                            @foreach (var group in VM.KnowledgeEntries.GroupBy(e => StaticLogics.GetBaseKnowledgeKey(e.Key)))
                                            {
                                                var baseKey = group.Key;
                                                var chunks = group.ToList();
                                                <li class="knowledge-file">
                                                    <div class="file-header">
                                                        <div class="file-title">@baseKey <span class="chunk-count">(@chunks.Count)</span></div>
                                                        <div class="file-actions">
                                                            <button class="delete-knowledge" @onclick="() => VM.DeleteKnowledgeByKeyAsync(baseKey)" title="Remove knowledge" disabled="@VM.IsKnowledgeBusy">−</button>
                                                        </div>
                                                    </div>

                                                    <details class="chunk-list">
                                                        <summary>@StaticLogics.GetChunkSummary(chunks)</summary>
                                                        <div class="chunk-items">
                                                            @for (int i = 0; i < chunks.Count; i++)
                                                            {
                                                                var item = chunks[i];
                                                                <div class="chunk-item">
                                                                    <div class="chunk-header">Chunk @(i + 1)</div>
                                                                    <div class="chunk-preview">@((MarkupString) System.Net.WebUtility.HtmlEncode(StaticLogics.GetChunkPreview(item.Content)))</div>
                                                                </div>
                                                            }
                                                        </div>
                                                    </details>
                                                </li>
                                            }
                                        </ul>
                                    </div>
                                }

                                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.End" Gap="0.6rem" Wrap="FlexWrap.Wrap">
                                    <RadzenFormField Text="Search Query" Variant="Variant.Outlined">
                                        <ChildContent>
                                            <RadzenTextBox @bind-Value="VM.KnowledgeQuery" Name="knowledgeQuery" Style="width:320px;" Disabled="@VM.IsKnowledgeBusy" />
                                        </ChildContent>
                                    </RadzenFormField>

                                    <RadzenFormField Text="Top K" Variant="Variant.Outlined">
                                        <ChildContent>
                                            <RadzenNumeric @bind-Value="VM.KnowledgeTopK" TValue="int" Min="1" Max="10" Step="1" Style="width:90px;" Disabled="@VM.IsKnowledgeBusy" />
                                        </ChildContent>
                                    </RadzenFormField>

                                    <RadzenButton Text="Search" Icon="search" ButtonStyle="ButtonStyle.Info" Disabled="@VM.IsKnowledgeBusy" Click="@VM.SearchKnowledgeAsync" />
                                </RadzenStack>

                                @if (VM.KnowledgeResults.Count > 0)
                                {
                                    <div class="knowledge-results">
                                        @foreach (var result in VM.KnowledgeResults)
                                        {
                                            <div class="knowledge-item">
                                                <div><strong>@result.Entry.Key</strong> <span class="score">(@result.Similarity:F3)</span></div>
                                                <div class="knowledge-preview">@result.Entry.Content</div>
                                            </div>
                                        }
                                    </div>
                                }
                        </RadzenStack>
                    }
                    else if (_managementTabIndex == 3)
                    {
                        <RadzenStack Gap="0.6rem" class="collapsible-inner">
                                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.End" Gap="0.6rem" Wrap="FlexWrap.Wrap">
                                    <RadzenFormField Text="Whisper Model" Variant="Variant.Outlined" Style="flex:1;min-width:200px;">
                                        <ChildContent>
                                            <RadzenDropDown @bind-Value="VM.SelectedWhisperModelName"
                                                            Data="@VM.WhisperModels"
                                                            TextProperty="ModelName"
                                                            ValueProperty="ModelName"
                                                            AllowFiltering="true"
                                                            FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                                                            FilterOperator="StringFilterOperator.Contains"
                                                            Placeholder="Select a whisper model…"
                                                            Disabled="@(VM.IsWhisperLoaded || VM.IsBusy)"
                                                            Style="width:100%;" />
                                        </ChildContent>
                                    </RadzenFormField>

                                    @if (VM.IsWhisperLoaded)
                                    {
                                        <RadzenButton Text="Unload" Icon="eject" ButtonStyle="ButtonStyle.Danger" Click="VM.UnloadWhisperModel" Disabled="@(VM.IsBusy || VM.IsWhisperTranscribing || VM.IsWhisperLiveMode)" />
                                    }
                                    else
                                    {
                                        <RadzenButton Text="Load" Icon="download" ButtonStyle="ButtonStyle.Primary" Click="VM.LoadWhisperModelAsync" Disabled="@(VM.IsBusy || string.IsNullOrEmpty(VM.SelectedWhisperModelName))" />
                                    }
                                </RadzenStack>

                                <div style="display:flex;flex-direction:column;gap:0.5rem;">
                                    <RadzenText TextStyle="TextStyle.Caption" Text="Select and load a Whisper GGML model (.bin) to enable speech-to-text. Use the mic button below to record and transcribe." />

                                    <div style="display:flex;gap:0.6rem;align-items:center;flex-wrap:wrap;">
                                        <RadzenFormField Text="Language" Variant="Variant.Outlined" Style="width:180px;">
                                            <ChildContent>
                                                <RadzenDropDown @bind-Value="VM.WhisperLanguage"
                                                                Data="@(new string[]{ "auto","en","de","es","fr","it","pt","nl","ru","zh","ja","ko" })"
                                                                Style="width:100%;" />
                                            </ChildContent>
                                        </RadzenFormField>

                                        <RadzenCheckBox TValue="bool" @bind-Value="VM.WhisperTimestamps" />
                                        <RadzenLabel Text="Timestamps" />

                                        <RadzenCheckBox TValue="bool" @bind-Value="VM.WhisperSpeakers" />
                                        <RadzenLabel Text="Speakers" />
                                    </div>
                                </div>
                        </RadzenStack>
                    }
                </div>
            </RadzenCard>

            </RadzenStack>
        </div>
        <div id="top-panels-resize-handle" class="top-panels-resize-handle" title="Drag to resize">
            <RadzenIcon Icon="drag_indicator" />
        </div>
    </div>

    <div class="page-content-wrapper">
        <div id="chat-output" class="page-content">
            <div class="home-shell">
    <RadzenCard class="chat-card">
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween" class="rz-mb-2">
            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                <RadzenIcon Icon="chat" />
                <RadzenText TextStyle="TextStyle.H5" Text="Chat / Generate" class="rz-mb-0" />
            </RadzenStack>

            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                <RadzenBadge BadgeStyle="@(VM.IsGenerating ? BadgeStyle.Warning : BadgeStyle.Success)" Text="@(VM.IsGenerating ? "Generating" : "Idle")" />
                <RadzenBadge BadgeStyle="@(VM.IsolatedGeneration ? BadgeStyle.Secondary : BadgeStyle.Info)" Text="@(VM.IsolatedGeneration ? "Isolated" : "Contextual")" />
                @if (VM.IsVolatileContext)
                {
                    <RadzenBadge BadgeStyle="BadgeStyle.Warning" Text="Volatile" />
                }
            </RadzenStack>
        </RadzenStack>

        @if (VM.ChatMessages.Count == 0)
        {
            <RadzenText TextStyle="TextStyle.Caption" Text="No conversation yet. Load a model and start with a prompt or load a previous context." />
        }
        else
        {
            @foreach (var message in VM.ChatMessages)
            {
                <div class="chat-message @message.Role">
                    <div class="chat-role-row">
                        <span class="chat-role">@message.Role.ToUpperInvariant()</span>
                        @if (message.CreatedAtUtc != default)
                        {
                            <span class="chat-timestamp">@message.CreatedAtUtc.ToLocalTime().ToString("HH:mm:ss")</span>
                        }
                    </div>
                    <div class="chat-content">@((MarkupString) VM.RenderChatContent(message.Content ?? string.Empty))</div>
                </div>
            }
        }
    </RadzenCard>
            </div>
        </div>
        <button id="chat-scroll-bottom-button"
                type="button"
                class="chat-scroll-bottom-button"
                title="Scroll to latest messages"
                @onclick="VM.ScrollChatToBottomAsync">
            ↓
        </button>
    </div>

    <div id="chat-footer" class="chat-footer">
                @if (VM.HasPendingCommandRequest)
                {
                    <RadzenAlert AlertStyle="AlertStyle.Warning" Shade="Shade.Lighter" ShowIcon="true" class="chat-footer-section">
                        <div><strong>Pending Command Request</strong></div>
                        @if (VM.PendingCommandSafety != null)
                        {
                            <div style="margin-top:0.2rem;"><strong>Safety:</strong> @VM.PendingCommandSafety.SafetyLevel</div>
                            <div style="white-space:pre-wrap;opacity:0.9;">@VM.PendingCommandSafety.Reason</div>
                        }
                        <div style="white-space:pre-wrap;margin-top:0.3rem;">@VM.PendingCommandRequest!.Command</div>
                        <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" class="rz-mt-2">
                            <RadzenButton Text="Run Command" Icon="terminal" ButtonStyle="ButtonStyle.Warning" Disabled="@VM.IsGenerating" Click="@VM.ConfirmPendingCommandAsync" />
                            <RadzenButton Text="Reject" Icon="close" ButtonStyle="ButtonStyle.Light" Disabled="@VM.IsGenerating" Click="@VM.RejectPendingCommand" />
                        </RadzenStack>
                    </RadzenAlert>
                }

                @if (VM.HasPendingWebSearchRequest)
                {
                    <RadzenAlert AlertStyle="AlertStyle.Info" Shade="Shade.Lighter" ShowIcon="true" class="chat-footer-section">
                        <div><strong>Pending Web Search Request</strong></div>
                        <div style="white-space:pre-wrap;margin-top:0.3rem;">
                            @(VM.PendingWebSearchRequest!.IsDirectUrl
                                ? VM.PendingWebSearchRequest.Url
                                : VM.PendingWebSearchRequest.Query)
                        </div>
                        <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" class="rz-mt-2">
                            <RadzenButton Text="Run Search" Icon="travel_explore" ButtonStyle="ButtonStyle.Info" Disabled="@VM.IsGenerating" Click="@VM.ConfirmPendingWebSearchAsync" />
                            <RadzenButton Text="Reject" Icon="close" ButtonStyle="ButtonStyle.Light" Disabled="@VM.IsGenerating" Click="@VM.RejectPendingWebSearch" />
                        </RadzenStack>
                    </RadzenAlert>
                }

                <RadzenCard Variant="Variant.Flat" class="gen-settings-card chat-footer-section">
                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                        <RadzenIcon Icon="tune" Style="font-size:1rem;" />
                        <RadzenText TextStyle="TextStyle.Subtitle2" Text="Generation Settings" class="rz-mb-0" />
                        <div style="flex:1"></div>
                        @if (VM.MonitoringEnabled && VM.LastGenerationStats != null)
                        {
                            // Vertical stack or div
                            <div style="display:flex;flex-direction:column;gap:0.1rem;font-size:0.75rem;text-align:right;">
                                <RadzenText TextStyle="TextStyle.Caption" class="generation-stats-caption generation-stats-in-footer" Text="@VM.GenerationStatsLast" />
                                <RadzenText TextStyle="TextStyle.Caption" class="generation-stats-caption generation-stats-in-footer" Text="@VM.GenerationStatsPowerUsage" />
                                <RadzenText TextStyle="TextStyle.Caption" class="generation-stats-caption generation-stats-in-footer" Text="@VM.GenerationStatsContingent" />
                            </div>
                        }
                        <RadzenButton Icon="@(VM.GenSettingsExpanded ? "remove" : "add")" Size="ButtonSize.Small" class="collapse-btn" Click="VM.ToggleGenSettingsAsync" />
                    </RadzenStack>

                    <div class="collapsible @(VM.GenSettingsExpanded ? "expanded" : "collapsed")">
                        <RadzenStack Gap="0.6rem" class="collapsible-inner">
                            <div class="settings-group-title">General</div>
                            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.4rem" Wrap="FlexWrap.Wrap" class="settings-option-row">
                                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.3rem" class="settings-toggle-item">
                                    <RadzenCheckBox TValue="bool" @bind-Value="VM.IsolatedGeneration" Name="isolatedGeneration" />
                                    <RadzenLabel Text="Isolated (stateless)" Component="isolatedGeneration" />
                                </RadzenStack>
                                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.3rem" class="settings-toggle-item">
                                    <RadzenCheckBox TValue="bool" @bind-Value="VM.UseSystemPrompt" Name="useSystemPrompt" />
                                    <RadzenLabel Text="System Prompt" Component="useSystemPrompt" />
                                </RadzenStack>
                                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.3rem" class="settings-toggle-item">
                                    <RadzenCheckBox TValue="bool" @bind-Value="VM.AutoSaveEnabled" Name="autoSaveGeneration" />
                                    <RadzenLabel Text="Auto Save Context" Component="autoSaveGeneration" />
                                </RadzenStack>
                                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.3rem" class="settings-toggle-item">
                                    <RadzenCheckBox TValue="bool" @bind-Value="VM.AutoScrollEnabled" Name="autoScrollGeneration" />
                                    <RadzenLabel Text="Auto Scroll" Component="autoScrollGeneration" />
                                </RadzenStack>
                            </RadzenStack>

                            <div class="settings-group-title">Agent Tools</div>
                            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.4rem" Wrap="FlexWrap.Wrap" class="settings-option-row">
                                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.3rem" class="settings-toggle-item">
                                    <RadzenCheckBox TValue="bool" @bind-Value="VM.EnableCommandAgentMode" Name="enableCommandAgentMode" />
                                    <RadzenLabel Text="Command" Component="enableCommandAgentMode" />
                                </RadzenStack>
                                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.3rem" class="settings-toggle-item">
                                    <RadzenCheckBox TValue="bool" @bind-Value="VM.EnableWebSearchAgentMode" Name="enableWebSearchAgentMode" />
                                    <RadzenLabel Text="Web Search" Component="enableWebSearchAgentMode" />
                                </RadzenStack>
                                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.3rem" class="settings-toggle-item">
                                    <RadzenCheckBox TValue="bool" @bind-Value="VM.AutoAllowWebSearch" Name="autoAllowWebSearch" />
                                    <RadzenLabel Text="Auto Allow WebSearch" Component="autoAllowWebSearch" />
                                </RadzenStack>
                                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.3rem" class="settings-toggle-item">
                                    <RadzenCheckBox TValue="bool" @bind-Value="VM.AutoContinueAgentActions" Name="autoContinueAgentActions" />
                                    <RadzenLabel Text="Auto Continue" Component="autoContinueAgentActions" />
                                </RadzenStack>
                                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.3rem" class="settings-toggle-item">
                                    <RadzenCheckBox TValue="bool" @bind-Value="VM.AgentShowCommandWindow" Name="agentShowCmdWindow" />
                                    <RadzenLabel Text="Show CMD Window" Component="agentShowCmdWindow" />
                                </RadzenStack>
                            </RadzenStack>

                            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.75rem" Wrap="FlexWrap.Wrap">
                                <RadzenButton Text="Browse JSON Format" Icon="data_object" ButtonStyle="ButtonStyle.Light" Disabled="@VM.IsGenerating" Click="VM.BrowseJsonFormatClickAsync" />
                                <InputFile id="jsonFormatPicker" OnChange="VM.OnJsonFormatSelectedAsync" accept=".json,application/json" style="display:none;" />

                                <RadzenCheckBox TValue="bool" @bind-Value="VM.UseJsonOutputFormat" Name="useJsonOutputFormat" Disabled="@(!VM.HasJsonOutputFormat)" />
                                <RadzenLabel Text="Formatted Output (JSON)" Component="useJsonOutputFormat" />

                                @if (!string.IsNullOrWhiteSpace(VM.JsonOutputFormatFileName))
                                {
                                    <RadzenText TextStyle="TextStyle.Caption" Text="@($"Loaded: {VM.JsonOutputFormatFileName}")" />
                                    <RadzenButton Icon="close"
                                                  Size="ButtonSize.Small"
                                                  ButtonStyle="ButtonStyle.Danger"
                                                  Shade="Shade.Lighter"
                                                  Disabled="@VM.IsGenerating"
                                                  Click="@VM.ClearJsonOutputFormat"
                                                  title="Remove JSON format" />
                                }
                            </RadzenStack>

                            @if (!string.IsNullOrWhiteSpace(VM.JsonOutputFormatWarning))
                            {
                                <RadzenAlert AlertStyle="AlertStyle.Warning" Shade="Shade.Lighter" ShowIcon="true">
                                    @VM.JsonOutputFormatWarning
                                </RadzenAlert>
                            }

                            @if (VM.HasJsonOutputFormat)
                            {
                                <RadzenTextArea Value="@VM.JsonOutputFormatTemplate" Rows="6" ReadOnly="true" Style="width:100%;" Name="jsonOutputFormatPreview" />
                            }

                            @if (VM.UseSystemPrompt)
                            {
                                <RadzenTextArea @bind-Value="VM.SystemPromptDisplay" Rows="3" Placeholder="System prompt..." Style="width:100%;" Name="systemPromptInput" />
                            }

                            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.End" Gap="0.6rem" Wrap="FlexWrap.Wrap">
                                <RadzenFormField Text="Max Tokens" Variant="Variant.Outlined">
                                    <ChildContent>
                                <RadzenNumeric @bind-Value="VM.GenMaxTokens" TValue="int" Min="0" Max="131072" Step="1024" Style="width:110px;" />
                                    </ChildContent>
                                </RadzenFormField>

                                <RadzenFormField Text="Temperature" Variant="Variant.Outlined">
                                    <ChildContent>
                                        <RadzenNumeric @bind-Value="VM.GenTemperature" TValue="float" Min="0" Max="2" Step="0.01" Style="width:110px;" />
                                    </ChildContent>
                                </RadzenFormField>

                                <RadzenFormField Text="Repetition Penalty" Variant="Variant.Outlined">
                                    <ChildContent>
                                        <RadzenNumeric @bind-Value="VM.GenRepetitionPenalty" TValue="double" Min="0" Max="10" Step="0.05" Style="width:140px;" />
                                    </ChildContent>
                                </RadzenFormField>

                                <RadzenFormField Text="Top P" Variant="Variant.Outlined">
                                    <ChildContent>
                                        <RadzenNumeric @bind-Value="VM.GenTopP" TValue="float" Min="0" Max="1" Step="0.01" Style="width:110px;" />
                                    </ChildContent>
                                </RadzenFormField>

                                <RadzenFormField Text="Top K" Variant="Variant.Outlined">
                                    <ChildContent>
                                        <RadzenNumeric @bind-Value="VM.GenTopK" TValue="int" Min="0" Max="256" Step="1" Style="width:110px;" />
                                    </ChildContent>
                                </RadzenFormField>

                                <RadzenFormField Text="Image Max Dim" Variant="Variant.Outlined">
                                    <ChildContent>
                                        <RadzenNumeric Value="@VM.ImageMaxDimension"
                                                       ValueChanged="@((int v) => VM.OnImageMaxDimensionChanged(v))"
                                                       TValue="int"
                                                       Min="0"
                                                       Max="8192"
                                                       Step="64"
                                                       Style="@($"width:110px;color:{(VM.ImageMaxDimension == 0 ? "gray" : "black")}")" />
                                    </ChildContent>
                                </RadzenFormField>

                                 <RadzenFormField Text="Image Format" Variant="Variant.Outlined">
                                    <ChildContent>
                                        <RadzenDropDown @bind-Value="VM.ImageFormat" Data="@(new string[]{"jpg","png","bmp"})" Style="width:110px;" />
                                    </ChildContent>
                                </RadzenFormField>
                            </RadzenStack>
                        </RadzenStack>
                    </div>
                </RadzenCard>

                <textarea id="promptInput"
                          @bind="VM.UserInput"
                          @bind:event="oninput"
                          rows="4"
                          placeholder="Enter your prompt..."
                          class="prompt-textarea"
                          disabled="@(!VM.IsLoaded || VM.IsBusy)"></textarea>

                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.End" Gap="0.6rem" Wrap="FlexWrap.Wrap">
                    <RadzenButton Text="Browse Images" Icon="image_search" ButtonStyle="ButtonStyle.Light" Click="VM.BrowseImagesClickAsync" Disabled="@VM.IsGenerating" />
                    <InputFile id="imagePicker" OnChange="VM.OnImagesSelectedAsync" multiple accept="image/*,.tif,.tiff" style="display:none;" />
                    <InputFile id="audioFilePicker" OnChange="VM.OnAudioFilesSelectedAsync" accept=".mp3,.wav,.flac,.ogg,audio/*" style="display:none;" />

                    <button id="micButton" type="button"
                            class="mic-btn @(VM.IsMicRecording ? "recording" : "") @(VM.IsWhisperTranscribing ? "transcribing" : "")"
                            style="@($"--mic-level:{VM.MicLevel:0.000};")"
                            disabled="@(!VM.IsWhisperLoaded || VM.IsGenerating || VM.IsWhisperTranscribing)"
                            title="@(VM.IsMicRecording ? "Recording... click or release to stop" : "Click or hold to record audio. Right-click to upload an audio file.")">
                        <span class="mic-level-fill" aria-hidden="true"></span>
                        <i class="rzi mic-btn-icon">@(VM.IsMicRecording ? "stop" : VM.IsWhisperTranscribing ? "hourglass_empty" : "mic")</i>
                    </button>

                    <RadzenButton Text="@(VM.IsWhisperLiveMode ? "Stop Live" : "Live")"
                                  Icon="@(VM.IsWhisperLiveMode ? "hearing_disabled" : "hearing")"
                                  ButtonStyle="@(VM.IsWhisperLiveMode ? ButtonStyle.Danger : ButtonStyle.Light)"
                                  Click="VM.ToggleLiveModeAsync"
                                  Disabled="@(!VM.IsWhisperLoaded || VM.IsGenerating || VM.IsMicRecording)" />

                    <RadzenButton Text="Generate" Icon="send" ButtonStyle="ButtonStyle.Primary" Disabled="@(!VM.CanSend || !VM.IsLoaded || VM.IsBusy)" Click="@VM.StartGenerationAsync" />
                    <RadzenButton Text="Cancel" Icon="stop" ButtonStyle="ButtonStyle.Warning" Disabled="@(!VM.IsGenerating)" Click="@VM.CancelGeneration" />
                    <RadzenButton Text="Reset" Icon="restart_alt" ButtonStyle="ButtonStyle.Light" Disabled="@(VM.IsGenerating)" Click="@VM.ResetConversationAsync" />
                </RadzenStack>

                @if (VM.SelectedImagePaths.Count > 0)
                {
                    <RadzenCard Variant="Variant.Flat" class="image-files-card chat-footer-section">
                        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" class="rz-mb-1">
                            <RadzenText TextStyle="TextStyle.Subtitle2" Text="@($"Image Attachments ({VM.SelectedImagePaths.Count})")" />
                            <div style="flex:1"></div>
                            <RadzenButton Icon="@(VM.ImageAttachmentsExpanded ? "remove" : "add")" Size="ButtonSize.Small" class="collapse-btn" Click="VM.ToggleImageAttachments" />
                        </RadzenStack>

                        <div class="collapsible @(VM.ImageAttachmentsExpanded ? "expanded" : "collapsed")">
                            <div class="image-chip-wrap collapsible-inner">
                                @foreach (var image in VM.SelectedImagePaths.ToList())
                                {
                                    var img = image;
                                    <span class="image-chip">
                                        <span class="image-chip-label">@VM.GetImageDisplayLabel(img)</span>
                                        <button type="button" class="image-chip-remove" @onclick="() => VM.RemoveImagePath(img)">✕</button>
                                    </span>
                                }
                            </div>
                        </div>
                    </RadzenCard>
                }
            </div>
</div>

@code {
    private int _managementTabIndex;
    private DotNetObjectReference<HomeViewModel>? _vmRef;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            VM.RegisterStateChangeListener(OnViewModelStateChanged);
            _vmRef = DotNetObjectReference.Create(VM);
            await VM.OnFirstRenderAsync(_vmRef);
            StateHasChanged();
            return;
        }

        if (_vmRef != null)
        {
            await VM.OnSubsequentRenderAsync(_vmRef);
        }
    }

    public void Dispose()
    {
        VM.UnregisterStateChangeListener(OnViewModelStateChanged);
        _vmRef?.Dispose();
    }

    private void OnViewModelStateChanged()
    {
        _ = InvokeAsync(StateHasChanged);
    }
}

@using System.Threading
@page "/"
@page "/home"
@rendermode InteractiveServer

@using Microsoft.AspNetCore.Components.Forms
@using System.Globalization
@using SharpestLlmStudio.Shared
@using SharpestLlmStudio.WebApp.ViewModels
@using static SharpestLlmStudio.WebApp.ViewModels.HomeViewModel
@using Radzen
@using Radzen.Blazor

@inject HomeViewModel VM
@inject IJSRuntime JSRuntime
@implements IDisposable

<PageTitle>Home – SharpestLlmStudio</PageTitle>

<div class="page-wrapper">
    <div class="top-panels-container">
        <div id="top-panels-content" class="top-panels-content" data-expanded="@VM.TopPanelsExpanded.ToString().ToLowerInvariant()" style="@VM.TopPanelsMaxHeightStyle">
            <RadzenStack Gap="1rem" class="home-shell top-panels-shell">
            <RadzenCard class="management-tabs-card">
                <div class="management-tab-header">
                    <button type="button" class="management-tab-button @(_managementTabIndex == 0 ? "active" : null)" @onclick="() => OnManagementTabClick(0)">Model Management</button>
                    <button type="button" class="management-tab-button @(_managementTabIndex == 1 ? "active" : null)" @onclick="() => OnManagementTabClick(1)">Context Management</button>
                    <button type="button" class="management-tab-button @(_managementTabIndex == 2 ? "active" : null)" @onclick="() => OnManagementTabClick(2)">Knowledge Base</button>
                    <button type="button" class="management-tab-button @(_managementTabIndex == 3 ? "active" : null)" @onclick="() => OnManagementTabClick(3)">Speech-to-Text</button>
                    <button type="button" class="management-tab-button @(_managementTabIndex == 4 ? "active" : null)" @onclick="() => OnManagementTabClick(4)">JSON + Image</button>
                    <button type="button" class="management-tab-button @(_managementTabIndex == 5 ? "active" : null)" @onclick="() => OnManagementTabClick(5)">Clicker</button>
                </div>

                <div class="management-tab-body">
                    @if (_managementTabIndex == 0)
                    {
                        <RadzenStack Gap="1rem" class="collapsible-inner">
                                <RadzenFormField Text="Model Usage" Variant="Variant.Outlined" Style="width:280px;">
                                    <ChildContent>
                                        <RadzenDropDown @bind-Value="VM.SelectedModelUsageMode"
                                                        Data="@HomeViewModel.ModelUsageOptions"
                                                        TextProperty="Text"
                                                        ValueProperty="Value"
                                                        Disabled="@(VM.IsLoaded || VM.IsBusy)"
                                                        Style="width:100%;" />
                                    </ChildContent>
                                </RadzenFormField>

                                @if (VM.UseRemoteProvider)
                                {
                                    <RadzenStack Gap="0.75rem">
                                        <RadzenStack Orientation="Orientation.Horizontal" Gap="1rem" Wrap="FlexWrap.Wrap">
                                            <RadzenFormField Text="Provider" Variant="Variant.Outlined">
                                                <ChildContent>
                                                    <RadzenDropDown @bind-Value="VM.SelectedRemoteProvider" Data="@VM.RemoteProviders" Style="width:220px;" Change="@(async (args) => await VM.OnRemoteProviderChanged((RemoteLlmProvider)args))" />
                                                </ChildContent>
                                            </RadzenFormField>

                                            <RadzenFormField Text="Remote Model Id" Variant="Variant.Outlined">
                                                <ChildContent>
                                                    @if (VM.IsFetchingRemoteModels)
                                                    {
                                                        <div style="display:flex;align-items:center;gap:0.5rem;"><RadzenProgressBar Mode="ProgressBarMode.Indeterminate" Style="width:160px;" /><RadzenText Text="Fetching models..." /></div>
                                                    }
                                                    else if (VM.DynamicRemoteModels != null && VM.DynamicRemoteModels.Count > 0)
                                                    {
                                                         <RadzenDropDown @bind-Value="VM.RemoteModelId" Data="@VM.DynamicRemoteModels" Style="width:260px;" Change="@(args => { if (args != null) VM.RemoteModelId = args.ToString() ?? string.Empty; })" />
                                                    }
                                                    else
                                                    {
                                                        <RadzenTextBox @bind-Value="VM.RemoteModelId" Style="width:260px;" />
                                                    }
                                                    <RadzenButton Icon="refresh" Style="margin-left:0.5rem;" Click="@(async () => await VM.RefreshRemoteModelListAsync())" />
                                                </ChildContent>
                                            </RadzenFormField>

                                            <RadzenFormField Text="Embedding Model Id" Variant="Variant.Outlined">
                                                <ChildContent>
                                                    <RadzenTextBox @bind-Value="VM.RemoteEmbeddingModelId" Style="width:260px;" />
                                                </ChildContent>
                                            </RadzenFormField>
                                        </RadzenStack>

                                        <RadzenStack Orientation="Orientation.Horizontal" Gap="1rem" Wrap="FlexWrap.Wrap">
                                            <RadzenFormField Text="API Key" Variant="Variant.Outlined">
                                                <ChildContent>
                                                    @if (VM.RemoteApiKeyVisible)
                                                    {
                                                        <RadzenTextBox @bind-Value="VM.RemoteApiKey" Style="width:360px;" />
                                                    }
                                                    else
                                                    {
                                                        <RadzenPassword @bind-Value="VM.RemoteApiKey" Style="width:360px;" />
                                                    }
                                                    <RadzenButton Icon="visibility" Style="margin-left:0.5rem;" Click="@( () => VM.ToggleRemoteApiKeyVisible() )" />
                                                </ChildContent>
                                            </RadzenFormField>

                                            <RadzenFormField Text="Base URL" Variant="Variant.Outlined">
                                                <ChildContent>
                                                    <RadzenTextBox @bind-Value="VM.RemoteBaseUrl" Placeholder="Optional for built-in providers" Style="width:360px;" />
                                                </ChildContent>
                                            </RadzenFormField>
                                        </RadzenStack>

                                        <RadzenText TextStyle="TextStyle.Body2" class="rz-color-on-surface-variant">@VM.RemoteConnectionStatus</RadzenText>
                                        @if (!string.IsNullOrWhiteSpace(VM.RemoteModelListError))
                                        {
                                            <RadzenText TextStyle="TextStyle.Caption" Style="color:#FF6B6B;">@VM.RemoteModelListError</RadzenText>
                                        }
                                    </RadzenStack>
                                }
                                else if (VM.UseWebChatProvider)
                                {
                                    <RadzenStack Gap="0.75rem">
                                        <RadzenStack Orientation="Orientation.Horizontal" Gap="1rem" Wrap="FlexWrap.Wrap">
                                            <RadzenFormField Text="Web Chat Provider" Variant="Variant.Outlined">
                                                <ChildContent>
                                                    <RadzenDropDown @bind-Value="VM.SelectedWebChatProvider"
                                                                    Data="@HomeViewModel.WebChatProviderOptions"
                                                                    TextProperty="Text"
                                                                    ValueProperty="Value"
                                                                    Disabled="@(VM.IsLoaded || VM.IsBusy)"
                                                                    Style="width:240px;" />
                                                </ChildContent>
                                            </RadzenFormField>

                                            <RadzenFormField Text="Target URL" Variant="Variant.Outlined">
                                                <ChildContent>
                                                    <RadzenTextBox Value="@VM.SelectedWebChatProviderUrl" Disabled="true" Style="width:360px;" />
                                                </ChildContent>
                                            </RadzenFormField>
                                        </RadzenStack>

                                        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" Wrap="FlexWrap.Wrap">
                                            <RadzenCheckBox @bind-Value="VM.WebChatOpenBrowserOnPrepare" Disabled="@(VM.IsBusy)" TValue="bool" />
                                            <RadzenLabel Text="Open provider website in browser when preparing" Style="cursor:pointer;" />
                                            <RadzenCheckBox @bind-Value="VM.WebChatCopyLatestScreenshotOnPrepare" Disabled="@(VM.IsBusy)" TValue="bool" />
                                            <RadzenLabel Text="Copy latest Clicker screenshot to clipboard when preparing" Style="cursor:pointer;" />
                                        </RadzenStack>

                                        <RadzenText TextStyle="TextStyle.Body2" class="rz-color-on-surface-variant">@VM.WebChatConnectionStatus</RadzenText>
                                        <RadzenText TextStyle="TextStyle.Caption">@VM.SelectedWebChatProviderHints</RadzenText>
                                        <RadzenText TextStyle="TextStyle.Caption" Text="Use the Clicker on the provider page after marking the browser window. The latest Clicker screenshot can be copied to clipboard and pasted into the provider composer/upload flow." />
                                    </RadzenStack>
                                }
                                else
                                {
                                <div style="display:flex;gap:0.5rem;align-items:center;width:100%;">
                                    <div style="width:220px;display:flex;flex-direction:column;align-items:flex-start;">
                                        <div style="display:flex;align-items:center;gap:0.25rem;">
                                            <button class="rz-button" type="button" @onclick="@(async () => { VM.ModelSortIndex = Math.Max(0, VM.ModelSortIndex - 1); await Task.CompletedTask; })" disabled="@(VM.ModelSortIndex == 0)">▲</button>
                                            <button class="rz-button" type="button" @onclick="@(async () => { VM.ModelSortIndex = Math.Min(HomeViewModel.ModelSortOptions.Count - 1, VM.ModelSortIndex + 1); await Task.CompletedTask; })" disabled="@(VM.ModelSortIndex == HomeViewModel.ModelSortOptions.Count - 1)">▼</button>
                                            <span style="margin-left:0.5rem;font-size:0.9rem;">@HomeViewModel.ModelSortOptions[VM.ModelSortIndex]</span>
                                        </div>
                                    </div>
                                    <div style="flex:1;">
                                        <RadzenFormField Text="Model" Variant="Variant.Outlined" Style="width:100%;">
                                            <ChildContent>
                                                <RadzenDropDown @bind-Value="VM.SelectedModelName"
                                                                Data="@VM.LlamaModels"
                                                                TextProperty="DisplayName"
                                                                ValueProperty="Name"
                                                                AllowFiltering="true"
                                                                FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                                                                FilterOperator="StringFilterOperator.Contains"
                                                                Placeholder="Select a model…"
                                                                Disabled="@(VM.IsLoaded || VM.IsBusy)"
                                                                Style="width:100%;"
                                                                Change="@VM.OnSelectedModelChanged" />
                                            </ChildContent>
                                        </RadzenFormField>
                                    </div>
                                </div>

                                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                                    <RadzenCheckBox @bind-Value="VM.UseMmproj" Disabled="@(VM.IsSelectedOmni || !VM.HasMmproj || VM.IsLoaded || VM.IsBusy)" TValue="bool" />
                                    <RadzenLabel Text="@VM.MmprojLabel" Style="cursor:pointer;" />
                                </RadzenStack>

                                <div style="display:flex;gap:1.5rem;flex-wrap:wrap;">
                                    <RadzenFormField Text="Context Size" Variant="Variant.Outlined">
                                        <ChildContent>
                                            <RadzenNumeric @bind-Value="VM.ContextSize" Min="128" Max="131072" Step="512" Disabled="@(VM.IsLoaded || VM.IsBusy)" TValue="int" />
                                        </ChildContent>
                                    </RadzenFormField>

                                    <RadzenFormField Text="Batch Size" Variant="Variant.Outlined">
                                        <ChildContent>
                                            <RadzenNumeric @bind-Value="VM.GenBatchSize" Min="32" Max="8192" Step="128" Disabled="@(VM.IsLoaded || VM.IsBusy)" TValue="int" />
                                        </ChildContent>
                                    </RadzenFormField>

                                    <RadzenFormField Text="U-Batch Size" Variant="Variant.Outlined">
                                        <ChildContent>
                                            <RadzenNumeric @bind-Value="VM.GenUBatchSize" Min="32" Max="8192" Step="128" Disabled="@(VM.IsLoaded || VM.IsBusy || !VM.UseMmproj)" TValue="int" />
                                        </ChildContent>
                                    </RadzenFormField>
                                </div>

                                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                                    <RadzenCheckBox @bind-Value="VM.UseFlashAttention" Disabled="@(VM.IsLoaded || VM.IsBusy)" TValue="bool" />
                                    <RadzenLabel Text="Flash Attention" Style="cursor:pointer;" />
                                    <RadzenCheckBox @bind-Value="VM.NoWarmup" Disabled="@(VM.IsLoaded || VM.IsBusy)" TValue="bool" />
                                    <RadzenLabel Text="No Warmup" Style="cursor:pointer;" />
                                </RadzenStack>
                                }

                                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" Wrap="FlexWrap.Wrap">
                                    <RadzenButton Text="@(VM.UseWebChatProvider ? "Prepare Web Chat" : VM.IsLoaded ? (VM.UseRemoteProvider ? "Disconnect Provider" : "Unload Model") : (VM.UseRemoteProvider ? "Connect Provider" : "Load Model"))"
                                                  Icon="@(VM.UseWebChatProvider ? "open_in_browser" : VM.IsLoaded ? "eject" : VM.UseRemoteProvider ? "link" : "download")"
                                                  ButtonStyle="@(VM.IsLoaded ? ButtonStyle.Danger : ButtonStyle.Primary)"
                                                  IsBusy="@VM.IsBusy"
                                                  Disabled="@(VM.IsBusy || VM.IsKnowledgeBusy || (!VM.UseWebChatProvider && !VM.IsLoaded && (VM.UseRemoteProvider ? string.IsNullOrWhiteSpace(VM.RemoteApiKey) || string.IsNullOrWhiteSpace(VM.RemoteModelId) : string.IsNullOrEmpty(VM.SelectedModelName))))"
                                                  Click="@OnModelPrimaryActionClick" />

                                    @if (VM.UseWebChatProvider)
                                    {
                                        <RadzenButton Text="Copy Latest Clicker Screenshot" Icon="content_paste" ButtonStyle="ButtonStyle.Light" Disabled="@(VM.IsBusy || string.IsNullOrWhiteSpace(VM.ClickerScreenshotDataUrl))" Click="@VM.CopyLatestClickerScreenshotToClipboardAsync" />
                                    }

                                    <RadzenButton Text="Kill 'llama-server.exe'"
                                                  Icon="warning"
                                                  ButtonStyle="ButtonStyle.Danger"
                                                  Disabled="@(VM.IsBusy || VM.IsKnowledgeBusy || VM.UseRemoteProvider || VM.UseWebChatProvider)"
                                                  Click="@VM.KillAllLlamaServerExeInstancesAsync" />
                                </RadzenStack>

                                <RadzenText TextStyle="TextStyle.Body2" class="rz-color-on-surface-variant">@(VM.UseWebChatProvider ? VM.WebChatConnectionStatus : VM.ModelLoadingTimeString)</RadzenText>

                                @if (!string.IsNullOrEmpty(VM.LastLoadError))
                                {
                                    <RadzenAlert AlertStyle="AlertStyle.Danger" Shade="Shade.Lighter" AllowClose="true" ShowIcon="true" Close="@(() => VM.LastLoadError = null)">
                                        @VM.LastLoadError
                                    </RadzenAlert>
                                }
                        </RadzenStack>
                    }
                    else if (_managementTabIndex == 4)
                    {
                        <RadzenStack Gap="0.6rem" class="collapsible-inner">
                            <RadzenFormField Text="JSON Input" Variant="Variant.Outlined">
                                <ChildContent>
                                    <RadzenTextArea @bind-Value="VM.JsonImageInput" Rows="8" Style="@((VM.JsonImageInputHasError) ? "width:100%;border:1px solid red;" : "width:100%")" />
                                </ChildContent>
                            </RadzenFormField>

                            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.6rem">
                                @if (string.IsNullOrWhiteSpace(VM.JsonImageFileName))
                                {
                                    <RadzenButton Text="Upload Image" Icon="image" ButtonStyle="ButtonStyle.Light" Click="@VM.BrowseJsonImageClickAsync" />
                                }
                                else
                                {
                                    <RadzenButton Text="Clear Image" Icon="close" ButtonStyle="ButtonStyle.Danger" Click="@VM.ClearJsonImageAsync" />
                                }
                                <InputFile id="jsonImagePicker" OnChange="VM.OnJsonImageSelectedAsync" accept="image/*" style="display:none;" />
                                <RadzenText TextStyle="TextStyle.Caption" Text="@(!string.IsNullOrWhiteSpace(VM.JsonImageFileName) ? $"Selected: {VM.JsonImageFileName}" : "No image selected")" />

                                <div style="flex:1"></div>

                                <label style="display:flex;align-items:center;gap:0.5rem;">
                                    <span style="font-size:0.9rem;">Color</span>
                                    <input type="color" @bind="VM.JsonRenderColor" style="width:48px;height:32px;border:none;padding:0;" />
                                </label>

                                <RadzenNumeric @bind-Value="VM.JsonRenderStrokeWidth" TValue="int" Min="1" Max="20" Style="width:100px;" />

                                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.25rem">
                                    <RadzenCheckBox TValue="bool" @bind-Value="VM.JsonRenderLabels" />
                                    <RadzenLabel Text="Draw Labels" />
                                </RadzenStack>

                                <RadzenButton Text="Render" Icon="image_search" ButtonStyle="ButtonStyle.Primary" Disabled="@VM.IsGenerating" Click="@VM.RenderJsonImageAsync" />
                            </RadzenStack>

                            <div style="margin-top:0.6rem;">
                                @if (!string.IsNullOrWhiteSpace(VM.RenderedJsonImageDataUrl))
                                {
                                    <img src="@VM.RenderedJsonImageDataUrl" style="max-width:100%;height:auto;display:block;margin:0 auto;" />
                                }
                                else
                                {
                                    <div style="width:100%;height:240px;display:flex;align-items:center;justify-content:center;border:1px dashed #ccc;color:#888;">Rendered image will appear here</div>
                                }
                            </div>
                        </RadzenStack>
                    }
                    else if (_managementTabIndex == 5)
                    {
                        <RadzenStack Gap="0.75rem" class="collapsible-inner clicker-panel">
                            <RadzenText TextStyle="TextStyle.Body2" Text="Mark a target window, let the model analyze the screenshot, then perform the returned automation plan. Supported pointer actions include click, doubleclick, mouse down, and mouse up for drag/drop flows. Keyboard actions (including combos, key down/up, typing, and optional delay_ms between steps) are also supported via JSON steps." />

                            <details>
                                <summary style="cursor:pointer;user-select:none;">Click prompt</summary>
                                <div class="clicker-prompt-box" style="margin-top:0.5rem;">
                                    <RadzenFormField Text="Clicker Instructions" Variant="Variant.Outlined" Style="width:100%;">
                                        <ChildContent>
                                            <RadzenTextArea @bind-Value="VM.ClickerInstructionsDraft" Rows="5" Style="width:100%;display:block;" />
                                        </ChildContent>
                                    </RadzenFormField>

                                    <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" style="margin-top:0.5rem;">
                                        <RadzenButton Text="Update prompt" Icon="refresh" ButtonStyle="ButtonStyle.Primary" Click="VM.CommitClickerInstructionsDraft" />
                                    </RadzenStack>

                                    <details open>
                                        <summary style="cursor:pointer;user-select:none;">Live prompt preview</summary>
                                        <pre style="white-space:pre-wrap;margin:0.5rem 0 0 0;font-size:0.82rem;line-height:1.35;">@($"Analyze the screenshot and return one JSON object only.\nTask: {VM.ClickerInstructions}\nUse screenshot-relative coordinates, preferably 0..1000.\nIf no safe action exists, return {{\"point_2d\":[-1,-1],\"action\":null,\"reason\":\"not found\"}}.")</pre>
                                    </details>
                                </div>
                            </details>

                            <details>
                                <summary style="cursor:pointer;user-select:none;">Show JSON schema/examples for model output</summary>
                                <pre style="white-space:pre-wrap;margin:0.5rem 0 0 0;font-size:0.82rem;line-height:1.35;">Root object:
{
  "steps": [ Step... ],
  "reason": "why this plan advances the task"
}

Step variants:
1) Pointer step
{ "point_2d": [x,y], "action": "click|doubleclick|down|up", "delay_ms": 120 }

2) Keyboard combo step
{ "keys": ["ctrl","s"], "action": "press|down|up", "delay_ms": 120 }

3) Typing step
{ "type_text": "hello world", "delay_ms": 80 }

Example (pointer + keyboard):
{
  "steps": [
    { "point_2d": [512,742], "action": "click" },
    { "keys": ["ctrl","l"], "action": "press", "delay_ms": 100 },
    { "type_text": "https://example.com", "delay_ms": 80 },
    { "keys": ["enter"], "action": "press" }
  ],
  "reason": "Focus address bar and navigate"
}</pre>
                            </details>

                            <details>
                                <summary style="cursor:pointer;user-select:none;">Timing and preview scaling</summary>
                                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.End" Gap="0.75rem" Wrap="FlexWrap.Wrap" style="margin-top:0.5rem;">
                                    <RadzenText TextStyle="TextStyle.Caption" Text="Mark Window now uses next-click focus detection (no fixed wait delay)." />

                                    <RadzenFormField Text="Loop Interval (ms)" Variant="Variant.Outlined">
                                        <ChildContent>
                                            <RadzenNumeric @bind-Value="VM.ClickerLoopIntervalMs" TValue="int" Min="250" Max="60000" Step="250" Style="width:140px;" />
                                        </ChildContent>
                                    </RadzenFormField>

                                    <RadzenFormField Text="Preview Scale (%)" Variant="Variant.Outlined">
                                        <ChildContent>
                                            <RadzenNumeric @bind-Value="VM.ClickerPreviewScalePercent" TValue="int" Min="20" Max="100" Step="5" Style="width:140px;" />
                                        </ChildContent>
                                    </RadzenFormField>

                                    <RadzenFormField Text="Model Image Scale (%)" Variant="Variant.Outlined">
                                        <ChildContent>
                                            <RadzenNumeric @bind-Value="VM.ClickerModelImageScalePercent" TValue="int" Min="5" Max="100" Step="5" Style="width:160px;" />
                                        </ChildContent>
                                    </RadzenFormField>
                                </RadzenStack>
                            </details>

                            <details>
                                <summary style="cursor:pointer;user-select:none;">Execution options</summary>
                                <RadzenStack Gap="0.45rem" style="margin-top:0.5rem;">
                                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.3rem">
                                        <RadzenCheckBox TValue="bool" Value="@VM.ClickerIncludeWindowChrome" Change="@(async (args) => await VM.OnClickerIncludeWindowChromeChangedAsync((bool)args))" />
                                        <RadzenLabel Text="Include window frame/title bar in screenshot and mapping" />
                                    </RadzenStack>
                                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.3rem">
                                        <RadzenCheckBox TValue="bool" @bind-Value="VM.ClickerShowPreviewMarker" />
                                        <RadzenLabel Text="Show high-contrast target marker in screenshot preview" />
                                    </RadzenStack>
                                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.3rem">
                                        <RadzenCheckBox TValue="bool" @bind-Value="VM.ClickerUseBackgroundClick" />
                                        <RadzenLabel Text="Click in target window without moving mouse or stealing focus" />
                                    </RadzenStack>
                                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.3rem">
                                        <RadzenCheckBox TValue="bool" @bind-Value="VM.ClickerActivateWindowBeforeCapture" />
                                        <RadzenLabel Text="Activate window before capture / click" />
                                    </RadzenStack>
                                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.3rem">
                                        <RadzenCheckBox TValue="bool" @bind-Value="VM.ClickerDryRun" />
                                        <RadzenLabel Text="Dry run only" />
                                    </RadzenStack>
                                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.3rem">
                                        <RadzenCheckBox TValue="bool" @bind-Value="VM.ClickerRequirePointInsideWindow" />
                                        <RadzenLabel Text="Require target inside the active interaction region" />
                                    </RadzenStack>
                                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.3rem">
                                        <RadzenCheckBox TValue="bool" @bind-Value="VM.ClickerConfirmBeforeClick" />
                                        <RadzenLabel Text="Confirm before real click (Enter/Space confirm, Esc stops loop)" />
                                    </RadzenStack>
                                </RadzenStack>
                            </details>

                            <details>
                                <summary style="cursor:pointer;user-select:none;">Prompt and recovery options</summary>
                                <RadzenStack Gap="0.45rem" style="margin-top:0.5rem;">
                                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.3rem">
                                        <RadzenCheckBox TValue="bool" @bind-Value="VM.ClickerUseChatInputAsLiveNote" />
                                        <RadzenLabel Text="Use current chat input as live note during looping" />
                                    </RadzenStack>
                                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.3rem">
                                        <RadzenCheckBox TValue="bool" @bind-Value="VM.ClickerTellModelAboutProtectedZones" />
                                        <RadzenLabel Text="Tell the model about protected zones" />
                                    </RadzenStack>
                                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.3rem">
                                        <RadzenCheckBox TValue="bool" @bind-Value="VM.ClickerSendLastErrorToModel" />
                                        <RadzenLabel Text="Send the last Clicker error back to the model on the next attempt" />
                                    </RadzenStack>
                                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.3rem">
                                        <RadzenCheckBox TValue="bool" @bind-Value="VM.ClickerAllowModelQuestions" />
                                        <RadzenLabel Text="Allow the model to ask the user a question dialog with buttons and optional free-text input when a decision is required" />
                                    </RadzenStack>
                                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.3rem">
                                        <RadzenCheckBox TValue="bool" @bind-Value="VM.ClickerSafeMode" />
                                        <RadzenLabel Text="Safe Mode: one-shot ultra-compact Clicker prompt (128px image cap, no extra context)" />
                                    </RadzenStack>
                                    @if (!string.IsNullOrWhiteSpace(VM.ClickerLastErrorFeedback))
                                    {
                                        <div class="clicker-reason-block">@VM.ClickerLastErrorFeedback</div>
                                    }
                                </RadzenStack>
                            </details>

                            <details>
                                <summary style="cursor:pointer;user-select:none;">Interaction region</summary>
                                <RadzenStack Gap="0.45rem" style="margin-top:0.5rem;">
                                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.3rem">
                                        <RadzenCheckBox TValue="bool" Value="@VM.ClickerLimitInteractionRegion" Change="@(async (args) => await VM.OnClickerLimitInteractionRegionChangedAsync((bool)args))" />
                                        <RadzenLabel Text="Limit screenshot, mapping, and interaction to a custom rectangle inside the marked window" />
                                    </RadzenStack>
                                    <RadzenText TextStyle="TextStyle.Caption" Text="@($"Active region: {VM.ClickerInteractionRegionLabel}")" />
                                    <RadzenStack Orientation="Orientation.Horizontal" Gap="0.75rem" Wrap="FlexWrap.Wrap">
                                        <RadzenFormField Text="Min X" Variant="Variant.Outlined">
                                            <ChildContent>
                                                <RadzenNumeric Value="@VM.ClickerInteractionMinX" ValueChanged="@(async (int v) => await VM.OnClickerInteractionRegionChangedAsync("MinX", v))" TValue="int" Min="0" Max="10000" Step="1" Style="width:120px;" />
                                            </ChildContent>
                                        </RadzenFormField>
                                        <RadzenFormField Text="Min Y" Variant="Variant.Outlined">
                                            <ChildContent>
                                                <RadzenNumeric Value="@VM.ClickerInteractionMinY" ValueChanged="@(async (int v) => await VM.OnClickerInteractionRegionChangedAsync("MinY", v))" TValue="int" Min="0" Max="10000" Step="1" Style="width:120px;" />
                                            </ChildContent>
                                        </RadzenFormField>
                                        <RadzenFormField Text="Max X" Variant="Variant.Outlined">
                                            <ChildContent>
                                                <RadzenNumeric Value="@VM.ClickerInteractionMaxX" ValueChanged="@(async (int v) => await VM.OnClickerInteractionRegionChangedAsync("MaxX", v))" TValue="int" Min="0" Max="10000" Step="1" Style="width:120px;" />
                                            </ChildContent>
                                        </RadzenFormField>
                                        <RadzenFormField Text="Max Y" Variant="Variant.Outlined">
                                            <ChildContent>
                                                <RadzenNumeric Value="@VM.ClickerInteractionMaxY" ValueChanged="@(async (int v) => await VM.OnClickerInteractionRegionChangedAsync("MaxY", v))" TValue="int" Min="0" Max="10000" Step="1" Style="width:120px;" />
                                            </ChildContent>
                                        </RadzenFormField>
                                    </RadzenStack>
                                </RadzenStack>
                            </details>

                            @if (VM.ClickerUseChatInputAsLiveNote)
                            {
                                <RadzenText TextStyle="TextStyle.Caption" Text="The bottom chat input stays editable during looping. Its current content is included as a live note for the next Clicker iteration." />
                            }

                            @if (VM.IsClickerLoopRunning)
                            {
                                <RadzenText TextStyle="TextStyle.Caption" Text="Press Esc at any time to stop the running loop." />
                            }

                            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.6rem" Wrap="FlexWrap.Wrap">
                                <RadzenButton Text="Mark Active Window" Icon="filter_center_focus" ButtonStyle="ButtonStyle.Info" Disabled="@(VM.IsClickerBusy || VM.IsGenerating || VM.IsClickerProtectedZoneSelectionActive)" Click="@VM.MarkClickerWindowAsync" />
                                <RadzenButton Text="Clear Window" Icon="close" ButtonStyle="ButtonStyle.Light" Disabled="@(VM.IsClickerBusy)" Click="@VM.ClearClickerWindow" />
                                <RadzenButton Text="@(VM.IsClickerProtectedZoneSelectionActive ? "Cancel Zone Selection" : "Add Protected Zone")"
                                              Icon="@(VM.IsClickerProtectedZoneSelectionActive ? "close" : "crop_free")"
                                              ButtonStyle="ButtonStyle.Warning"
                                              Disabled="@(VM.IsClickerBusy || VM.IsGenerating || _vmRef == null || string.IsNullOrWhiteSpace(VM.ClickerMarkedWindowLabel) || VM.ClickerMarkedWindowLabel == "No window marked.")"
                                              Click="@(async () => { if (_vmRef != null) await VM.ToggleClickerProtectedZoneSelectionAsync(_vmRef); })" />
                                <RadzenButton Text="Run Once" Icon="play_arrow" ButtonStyle="ButtonStyle.Primary" Disabled="@(VM.IsClickerBusy || VM.IsGenerating || VM.IsClickerProtectedZoneSelectionActive || !VM.IsLoaded)" Click="@VM.RunClickerOnceAsync" />
                                <RadzenButton Text="@(VM.IsClickerLoopRunning ? "Stop Loop" : "Start Loop")" Icon="@(VM.IsClickerLoopRunning ? "stop" : "autorenew")" ButtonStyle="@(VM.IsClickerLoopRunning ? ButtonStyle.Danger : ButtonStyle.Success)" Disabled="@(VM.IsGenerating || VM.IsClickerProtectedZoneSelectionActive || !VM.IsLoaded)" Click="@VM.ToggleClickerLoopAsync" />
                            </RadzenStack>

                            @if (VM.ClickerProtectedZoneCount > 0)
                            {
                                <div class="clicker-protected-zone-list">
                                    <div class="clicker-preview-title">Protected Zones</div>
                                    <div class="clicker-protected-zone-chip-wrap">
                                        @foreach (var zone in VM.ClickerProtectedZones.ToList())
                                        {
                                            <span class="clicker-protected-zone-chip">
                                                @if (_editingClickerProtectedZoneId == zone.Id)
                                                {
                                                    <input class="clicker-protected-zone-name-input"
                                                           @bind="_editingClickerProtectedZoneName"
                                                           @bind:event="oninput"
                                                           @onblur="() => CommitProtectedZoneNameEdit(zone.Id)"
                                                           @onkeydown="@(args => OnProtectedZoneNameKeyDown(zone.Id, args))"
                                                           maxlength="80" />
                                                }
                                                else
                                                {
                                                    <button type="button" class="clicker-protected-zone-name-button" @ondblclick="() => BeginProtectedZoneNameEdit(zone)">
                                                        @zone.Name <span class="clicker-protected-zone-scope">@zone.ScopeLabel</span>
                                                    </button>
                                                }
                                                <button type="button" class="clicker-protected-zone-remove" @onclick="() => RemoveProtectedZone(zone.Id)">✕</button>
                                            </span>
                                        }
                                    </div>
                                </div>
                            }

                            <details>
                                <summary style="cursor:pointer;user-select:none;">Status</summary>
                                <div class="clicker-status-grid" style="margin-top:0.5rem;">
                                <div class="clicker-status-card">
                                    <div class="clicker-status-title">Marked Window</div>
                                    <div class="clicker-status-value">@VM.ClickerMarkedWindowLabel</div>
                                </div>
                                <div class="clicker-status-card">
                                    <div class="clicker-status-title">Loop State</div>
                                    <div class="clicker-status-value">@(VM.IsClickerLoopRunning ? "Running" : VM.IsClickerBusy ? "Working" : "Idle")</div>
                                </div>
                                <div class="clicker-status-card">
                                    <div class="clicker-status-title">Iterations</div>
                                    <div class="clicker-status-value">@VM.ClickerIterationCount</div>
                                </div>
                                <div class="clicker-status-card">
                                    <div class="clicker-status-title">Last Parsed Point</div>
                                    <div class="clicker-status-value">@(string.IsNullOrWhiteSpace(VM.ClickerLastParsedPoint) ? "n/a" : VM.ClickerLastParsedPoint)</div>
                                </div>
                                <div class="clicker-status-card">
                                    <div class="clicker-status-title">Last Parsed Action</div>
                                    <div class="clicker-status-value">@(string.IsNullOrWhiteSpace(VM.ClickerLastParsedAction) ? "n/a" : VM.ClickerLastParsedAction)</div>
                                </div>
                                <div class="clicker-status-card">
                                    <div class="clicker-status-title">Target Screen Point</div>
                                    <div class="clicker-status-value">@(string.IsNullOrWhiteSpace(VM.ClickerLastTargetScreenPoint) ? "n/a" : VM.ClickerLastTargetScreenPoint)</div>
                                </div>
                                <div class="clicker-status-card">
                                    <div class="clicker-status-title">Confirmation</div>
                                    <div class="clicker-status-value">@(string.IsNullOrWhiteSpace(VM.ClickerLastConfirmationOutcome) ? "n/a" : VM.ClickerLastConfirmationOutcome)</div>
                                </div>
                                <div class="clicker-status-card">
                                    <div class="clicker-status-title">Reason</div>
                                    <div class="clicker-status-value clicker-reason-text">@(string.IsNullOrWhiteSpace(VM.ClickerLastReason) ? "n/a" : VM.ClickerLastReason)</div>
                                </div>
                                @if (VM.MonitoringEnabled)
                                {
                                    <div class="clicker-status-card">
                                        <div class="clicker-status-title">Generation Stats</div>
                                        <div class="clicker-status-value clicker-reason-text">@(string.IsNullOrWhiteSpace(VM.GenerationStatsLast) ? "n/a" : VM.GenerationStatsLast)</div>
                                    </div>
                                    <div class="clicker-status-card">
                                        <div class="clicker-status-title">Power / Cost</div>
                                        <div class="clicker-status-value clicker-reason-text">@(string.IsNullOrWhiteSpace(VM.GenerationStatsPowerUsage) ? "n/a" : VM.GenerationStatsPowerUsage)</div>
                                    </div>
                                    <div class="clicker-status-card">
                                        <div class="clicker-status-title">Hardware Stats</div>
                                        <div class="clicker-status-value clicker-reason-text">@VM.StatsDisplay</div>
                                    </div>
                                }
                                </div>
                            </details>

                            @if (VM.ClickerLastRunAtUtc.HasValue)
                            {
                                <RadzenText TextStyle="TextStyle.Caption" Text="@($"Last run: {VM.ClickerLastRunAtUtc.Value.ToLocalTime():HH:mm:ss}")" />
                            }

                            @if (VM.HasPendingClickerQuestion)
                            {
                                <div style="position:fixed;inset:0;background:rgba(0,0,0,0.45);z-index:1200;display:flex;align-items:center;justify-content:center;padding:1rem;">
                                    <div style="background:white;color:black;max-width:680px;width:min(680px,100%);border-radius:10px;box-shadow:0 18px 42px rgba(0,0,0,0.35);padding:1rem;border-top:6px solid @VM.ClickerPendingQuestionAccentColor;">
                                        <div style="display:flex;align-items:center;gap:0.75rem;margin-bottom:0.75rem;background:@VM.ClickerPendingQuestionSurfaceColor;border-radius:8px;padding:0.75rem;">
                                            <RadzenIcon Icon="@VM.ClickerPendingQuestionIcon" Style="@($"font-size:1.6rem;color:{VM.ClickerPendingQuestionAccentColor};")" />
                                            <div style="font-weight:600;font-size:1.05rem;">@VM.ClickerPendingQuestionTitle</div>
                                        </div>
                                        <div class="clicker-reason-block" style="margin-bottom:0.75rem;">@VM.ClickerPendingQuestionText</div>
                                        <RadzenStack Gap="0.5rem">
                                            @foreach (string option in VM.ClickerPendingQuestionOptions.ToList())
                                            {
                                                <RadzenButton Text="@option" ButtonStyle="ButtonStyle.Primary" Style="justify-content:flex-start;text-align:left;" Click="@(() => VM.SelectClickerQuestionOption(option))" />
                                            }
                                        </RadzenStack>
                                        @if (VM.ClickerPendingQuestionAddTextOption)
                                        {
                                            <div style="margin-top:0.85rem;padding-top:0.75rem;border-top:1px solid #e5e7eb;">
                                                <RadzenFormField Text="@VM.ClickerPendingQuestionTextLabel" Variant="Variant.Outlined" Style="width:100%;">
                                                    <ChildContent>
                                                        <RadzenTextArea @bind-Value="VM.ClickerPendingQuestionTextAnswer" Rows="3" Placeholder="@VM.ClickerPendingQuestionTextPlaceholder" Style="width:100%;" />
                                                    </ChildContent>
                                                </RadzenFormField>
                                                <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" style="margin-top:0.5rem;">
                                                    <RadzenButton Text="@VM.ClickerPendingQuestionSubmitText" Icon="send" ButtonStyle="ButtonStyle.Secondary" Disabled="@string.IsNullOrWhiteSpace(VM.ClickerPendingQuestionTextAnswer)" Click="VM.SubmitClickerQuestionTextAnswer" />
                                                </RadzenStack>
                                            </div>
                                        }
                                        <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" style="margin-top:0.75rem;">
                                            <RadzenButton Text="Cancel" ButtonStyle="ButtonStyle.Light" Click="VM.CancelPendingClickerQuestion" />
                                        </RadzenStack>
                                    </div>
                                </div>
                            }

                            <details open>
                                <summary style="cursor:pointer;user-select:none;">Latest result</summary>
                                <div class="clicker-preview-grid" style="margin-top:0.5rem;">
                                <div class="clicker-preview-panel">
                                    <div class="clicker-preview-title">Latest Screenshot</div>
                                    @if (!string.IsNullOrWhiteSpace(VM.ClickerScreenshotDataUrl))
                                    {
                                        <div class="clicker-preview-image-wrap">
                                            <div id="clicker-preview-stage" class="clicker-preview-stage" style="width:@($"{VM.ClickerPreviewScalePercent}%");max-width:100%;">
                                                <img src="@VM.ClickerScreenshotDataUrl" class="clicker-preview-image" style="width:100%;max-width:100%;" />
                                                @foreach (var zone in VM.VisibleClickerProtectedZones)
                                                {
                                                    <div class="clicker-protected-zone-box"
                                                         style="left:@ToCssPercent(zone.LeftPercent);top:@ToCssPercent(zone.TopPercent);width:@ToCssPercent(zone.WidthPercent);height:@ToCssPercent(zone.HeightPercent);"
                                                         title="@($"Protected zone: {zone.Name}")"
                                                         aria-hidden="true">
                                                        <span class="clicker-protected-zone-box-label">@zone.Name</span>
                                                    </div>
                                                }
                                                @if (VM.ShowClickerInteractionZoneOverlay)
                                                {
                                                    <div class="clicker-interaction-zone-box"
                                                         style="left:@ToCssPercent(VM.ClickerInteractionZoneLeftPercent);top:@ToCssPercent(VM.ClickerInteractionZoneTopPercent);width:@ToCssPercent(VM.ClickerInteractionZoneWidthPercent);height:@ToCssPercent(VM.ClickerInteractionZoneHeightPercent);"
                                                         title="Interaction region"
                                                         aria-hidden="true">
                                                        <span class="clicker-interaction-zone-box-label">Interaction zone</span>
                                                    </div>
                                                }
                                                @if (VM.ClickerShowPreviewMarker && VM.HasClickerPreviewMarker)
                                                {
                                                    <div class="clicker-preview-marker"
                                                         style="left:@ToCssPercent(VM.ClickerPreviewMarkerLeftPercent ?? 0.0);top:@ToCssPercent(VM.ClickerPreviewMarkerTopPercent ?? 0.0);"
                                                         aria-hidden="true"></div>
                                                }
                                            </div>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="clicker-placeholder">No screenshot captured yet.</div>
                                    }
                                </div>

                                <div class="clicker-preview-panel">
                                    <div class="clicker-preview-title">Latest Raw Model Response</div>
                                    <pre class="clicker-response-block">@(string.IsNullOrWhiteSpace(VM.ClickerLastResponse) ? "No raw model response yet." : VM.ClickerLastResponse)</pre>
                                    @if (!string.IsNullOrWhiteSpace(VM.ClickerLastNormalizedJson))
                                    {
                                        <div class="clicker-preview-title">Parsed Result</div>
                                        <pre class="clicker-response-block">@VM.ClickerLastNormalizedJson</pre>
                                    }
                                    <div class="clicker-preview-title">Latest Model Reason</div>
                                    <div class="clicker-reason-block">@(string.IsNullOrWhiteSpace(VM.ClickerLastReason) ? "No reason extracted yet." : VM.ClickerLastReason)</div>
                                </div>
                                </div>
                            </details>
                        </RadzenStack>
                    }
                    else if (_managementTabIndex == 1)
                    {
                        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.End" Gap="0.6rem" Wrap="FlexWrap.Wrap" class="collapsible-inner">
                                <RadzenFormField Text="Save Name" Variant="Variant.Outlined">
                                    <ChildContent>
                                        <RadzenTextBox @bind-Value="VM.ContextSaveName" Name="contextSaveName" Style="width:180px;" />
                                    </ChildContent>
                                </RadzenFormField>

                                <RadzenButton Text="Save Context" Icon="save" ButtonStyle="ButtonStyle.Primary" Disabled="@(!VM.IsLoaded || VM.IsBusy || VM.IsGenerating)" Click="@VM.SaveContextAsync" />

                                <RadzenDropDown Data="VM.ContextFileDisplayItems" @bind-Value="VM.SelectedContextFilePath"
                                               TextProperty="DisplayName" ValueProperty="FullPath"
                                               Placeholder="Saved contexts..." Style="width:320px;" Name="selectedContextFile" />

                                <RadzenButton Text="Load" Icon="upload" ButtonStyle="ButtonStyle.Info" Disabled="@(string.IsNullOrWhiteSpace(VM.SelectedContextFilePath) || VM.IsGenerating)" Click="@VM.LoadSelectedContextAsync" />
                                <RadzenButton Text="Delete" Icon="delete" ButtonStyle="ButtonStyle.Danger" Disabled="@(string.IsNullOrWhiteSpace(VM.SelectedContextFilePath) || VM.IsGenerating)" Click="@VM.DeleteSelectedContextAsync" />
                        </RadzenStack>
                    }
                    else if (_managementTabIndex == 2)
                    {
                        <RadzenStack Gap="0.6rem" class="collapsible-inner">
                                @if (VM.IsKnowledgeBusy)
                                {
                                    <div class="knowledge-busy-indicator" role="status" aria-live="polite">
                                        <span class="knowledge-spinner" aria-hidden="true"></span>
                                        <div class="knowledge-busy-content">
                                            <span class="knowledge-busy-text">@VM.KnowledgeBusyMessage</span>
                                            <div class="knowledge-busy-actions">
                                                <span class="knowledge-elapsed">Elapsed: @VM.KnowledgeElapsedText</span>
                                                <RadzenButton Text="Abort"
                                                              Icon="stop"
                                                              ButtonStyle="ButtonStyle.Danger"
                                                              Size="ButtonSize.Small"
                                                              Click="@VM.CancelKnowledgeOperation" />
                                            </div>
                                            @if (VM.KnowledgeProgressPercent > 0 || !string.IsNullOrWhiteSpace(VM.KnowledgeProgressCurrentItem))
                                            {
                                                <div class="knowledge-progress-row">
                                                    <div class="knowledge-progress-bar">
                                                        <div class="knowledge-progress-fill" style="width:@($"{VM.KnowledgeProgressPercent}%")"></div>
                                                    </div>
                                                    <span class="knowledge-progress-value">@VM.KnowledgeProgressPercent%</span>
                                                </div>
                                                @if (!string.IsNullOrWhiteSpace(VM.KnowledgeProgressCurrentItem))
                                                {
                                                    <span class="knowledge-busy-subtext">@VM.KnowledgeProgressCurrentItem</span>
                                                }
                                            }
                                        </div>
                                    </div>
                                }

                                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" Wrap="FlexWrap.Wrap">
                                    <RadzenCheckBox TValue="bool" @bind-Value="VM.UseKnowledgeRagV2" Name="useKnowledgeRagV2" Disabled="@VM.IsKnowledgeBusy" />
                                    <RadzenLabel Text="Use RAG v2 (hybrid retrieval + grounded citations)" Component="useKnowledgeRagV2" />
                                    <RadzenBadge BadgeStyle="@(VM.UseKnowledgeRagV2 ? BadgeStyle.Info : BadgeStyle.Secondary)" Text="@(VM.UseKnowledgeRagV2 ? "RAG v2" : "Legacy")" />
                                </RadzenStack>

                                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.End" Gap="0.75rem" Wrap="FlexWrap.Wrap">
                                    <RadzenFormField Text="RAG Preset" Variant="Variant.Outlined">
                                        <ChildContent>
                                            <RadzenDropDown Data="HomeViewModel.KnowledgePresetModes"
                                                            @bind-Value="VM.SelectedKnowledgePreset"
                                                            TValue="HomeViewModel.KnowledgePresetMode"
                                                            Style="width:140px;"
                                                            Disabled="@VM.IsKnowledgeBusy" />
                                        </ChildContent>
                                    </RadzenFormField>

                                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.4rem">
                                        <RadzenCheckBox TValue="bool"
                                                        @bind-Value="VM.KnowledgeAutoChunkSize"
                                                        Name="knowledgeAutoChunkSize"
                                                        Disabled="@VM.IsKnowledgeBusy" />
                                        <RadzenLabel Text="Auto Chunk Size" Component="knowledgeAutoChunkSize" />
                                    </RadzenStack>

                                    <RadzenFormField Text="Chunk Size" Variant="Variant.Outlined">
                                        <ChildContent>
                                            <RadzenNumeric @bind-Value="VM.KnowledgeChunkSize"
                                                           TValue="int?"
                                                           Min="256"
                                                           Max="4096"
                                                           Step="128"
                                                           Style="width:130px;"
                                                           Disabled="@(VM.KnowledgeAutoChunkSize || VM.IsKnowledgeBusy)" />
                                        </ChildContent>
                                    </RadzenFormField>
                                </RadzenStack>

                                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.End" Gap="0.6rem" Wrap="FlexWrap.Wrap">
                                    <RadzenFormField Text="Key" Variant="Variant.Outlined">
                                        <ChildContent>
                                            <RadzenTextBox @bind-Value="VM.KnowledgeKey" Name="knowledgeKey" Style="width:220px;" Disabled="@VM.IsKnowledgeBusy" />
                                        </ChildContent>
                                    </RadzenFormField>

                                    <RadzenButton Text="Upsert" Icon="library_add" ButtonStyle="ButtonStyle.Primary" Disabled="@VM.IsKnowledgeBusy" Click="@VM.AddKnowledgeAsync" />
                                    <RadzenButton Text="Browse Files" Icon="upload_file" ButtonStyle="ButtonStyle.Info" Disabled="@VM.IsKnowledgeBusy" Click="VM.BrowseKnowledgeFilesClickAsync" />
                                    <InputFile id="knowledgeFilePicker" OnChange="VM.OnKnowledgeFilesSelectedAsync" multiple accept=".json,.xml,.txt,*/*" style="display:none;" disabled="@VM.IsKnowledgeBusy" />
                                    <RadzenButton Text="Save Store" Icon="file_download" ButtonStyle="ButtonStyle.Light" Disabled="@VM.IsKnowledgeBusy" Click="@VM.SaveKnowledgeStoreAsync" />
                                    <RadzenButton Text="Clear Store" Icon="delete_sweep" ButtonStyle="ButtonStyle.Danger" Disabled="@VM.IsKnowledgeBusy" Click="@VM.ClearKnowledgeStore" />
                                </RadzenStack>

                                <RadzenTextArea @bind-Value="VM.KnowledgeContent" Rows="4" Placeholder="JSON/XML/Text content for vectorization..." Style="width:100%;" Name="knowledgeContent" Disabled="@VM.IsKnowledgeBusy" />

                                @if (VM.KnowledgeEntries.Count > 0)
                                {
                                    <div class="knowledge-entries-list">
                                        <h4>Imported Knowledge</h4>
                                        <ul class="knowledge-list">
                                            @foreach (var group in VM.KnowledgeEntries.GroupBy(e => StaticLogics.GetBaseKnowledgeKey(e.Key)))
                                            {
                                                var baseKey = group.Key;
                                                var chunks = group.ToList();
                                                <li class="knowledge-file">
                                                    <div class="file-header">
                                                        <div class="file-title">@baseKey <span class="chunk-count">(@chunks.Count)</span></div>
                                                        <div class="file-actions">
                                                            <button class="delete-knowledge" @onclick="() => VM.DeleteKnowledgeByKeyAsync(baseKey)" title="Remove knowledge" disabled="@VM.IsKnowledgeBusy">−</button>
                                                        </div>
                                                    </div>

                                                    <details class="chunk-list">
                                                        <summary>@StaticLogics.GetChunkSummary(chunks)</summary>
                                                        <div class="chunk-items">
                                                            @for (int i = 0; i < chunks.Count; i++)
                                                            {
                                                                var item = chunks[i];
                                                                <div class="chunk-item">
                                                                    <div class="chunk-header">Chunk @(i + 1)</div>
                                                                    <div class="chunk-preview">@((MarkupString) System.Net.WebUtility.HtmlEncode(StaticLogics.GetChunkPreview(item.Content)))</div>
                                                                </div>
                                                            }
                                                        </div>
                                                    </details>
                                                </li>
                                            }
                                        </ul>
                                    </div>
                                }

                                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.End" Gap="0.6rem" Wrap="FlexWrap.Wrap">
                                    <RadzenFormField Text="Search Query" Variant="Variant.Outlined">
                                        <ChildContent>
                                            <RadzenTextBox @bind-Value="VM.KnowledgeQuery" Name="knowledgeQuery" Style="width:320px;" Disabled="@VM.IsKnowledgeBusy" />
                                        </ChildContent>
                                    </RadzenFormField>

                                    <RadzenFormField Text="Top K" Variant="Variant.Outlined">
                                        <ChildContent>
                                            <RadzenNumeric @bind-Value="VM.KnowledgeTopK" TValue="int" Min="1" Max="10" Step="1" Style="width:90px;" Disabled="@VM.IsKnowledgeBusy" />
                                        </ChildContent>
                                    </RadzenFormField>

                                    <RadzenButton Text="Search" Icon="search" ButtonStyle="ButtonStyle.Info" Disabled="@VM.IsKnowledgeBusy" Click="@VM.SearchKnowledgeAsync" />
                                </RadzenStack>

                                @if (VM.KnowledgeResults.Count > 0)
                                {
                                    <div class="knowledge-results">
                                        @foreach (var result in VM.KnowledgeResults)
                                        {
                                            <div class="knowledge-item">
                                                <div><strong>@result.Entry.Key</strong> <span class="score">(@result.Similarity:F3)</span></div>
                                                <div class="knowledge-preview">@result.Entry.Content</div>
                                            </div>
                                        }
                                    </div>
                                }
                        </RadzenStack>
                    }
                    else if (_managementTabIndex == 3)
                    {
                        <RadzenStack Gap="0.6rem" class="collapsible-inner">
                                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.End" Gap="0.6rem" Wrap="FlexWrap.Wrap">
                                    <RadzenFormField Text="Whisper Model" Variant="Variant.Outlined" Style="flex:1;min-width:200px;">
                                        <ChildContent>
                                            <RadzenDropDown @bind-Value="VM.SelectedWhisperModelName"
                                                            Data="@VM.WhisperModels"
                                                            TextProperty="ModelName"
                                                            ValueProperty="ModelName"
                                                            AllowFiltering="true"
                                                            FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                                                            FilterOperator="StringFilterOperator.Contains"
                                                            Placeholder="Select a whisper model…"
                                                            Disabled="@(VM.IsWhisperLoaded || VM.IsBusy)"
                                                            Style="width:100%;" />
                                        </ChildContent>
                                    </RadzenFormField>

                                    @if (VM.IsWhisperLoaded)
                                    {
                                        <RadzenButton Text="Unload" Icon="eject" ButtonStyle="ButtonStyle.Danger" Click="VM.UnloadWhisperModel" Disabled="@(VM.IsBusy || VM.IsWhisperTranscribing || VM.IsWhisperLiveMode)" />
                                    }
                                    else
                                    {
                                        <RadzenButton Text="Load" Icon="download" ButtonStyle="ButtonStyle.Primary" Click="VM.LoadWhisperModelAsync" Disabled="@(VM.IsBusy || string.IsNullOrEmpty(VM.SelectedWhisperModelName))" />
                                    }
                                </RadzenStack>

                                <div style="display:flex;flex-direction:column;gap:0.5rem;">
                                    <RadzenText TextStyle="TextStyle.Caption" Text="Select and load a Whisper GGML model (.bin) to enable speech-to-text. Use the mic button below to record and transcribe." />

                                    <div style="display:flex;gap:0.6rem;align-items:center;flex-wrap:wrap;">
                                        <RadzenFormField Text="Language" Variant="Variant.Outlined" Style="width:180px;">
                                            <ChildContent>
                                                <RadzenDropDown @bind-Value="VM.WhisperLanguage"
                                                                Data="@(new string[]{ "auto","en","de","es","fr","it","pt","nl","ru","zh","ja","ko" })"
                                                                Style="width:100%;" />
                                            </ChildContent>
                                        </RadzenFormField>

                                        <RadzenCheckBox TValue="bool" @bind-Value="VM.WhisperTimestamps" />
                                        <RadzenLabel Text="Timestamps" />


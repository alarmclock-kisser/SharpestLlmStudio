@code {
    private int _managementTabIndex;
    private DotNetObjectReference<HomeViewModel>? _vmRef;
    private CancellationTokenSource? _renderCts;
    private Guid? _editingClickerProtectedZoneId;
    private string _editingClickerProtectedZoneName = string.Empty;

    private async Task OnManagementTabClick(int index)
    {
        if (_managementTabIndex == index)
        {
            // toggle collapse when clicking active tab
            VM.TopPanelsExpanded = !VM.TopPanelsExpanded;
        }
        else
        {
            _managementTabIndex = index;
            // ensure expanded when switching tabs
            VM.TopPanelsExpanded = true;
            // inform ViewModel which tab is active so it can pick a preferred height
            try { VM.ActiveManagementTabIndex = index; } catch { }
        }

        // After toggling, ensure top-panels sizing is updated to fit to footer and enable inner scrolling if needed
        try { await JSRuntime.InvokeVoidAsync("sharpestNavMenu.ensureTopPanelsExpandedToFooter", "top-panels-content", "chat-footer"); } catch { }

        StateHasChanged();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            VM.RegisterStateChangeListener(OnViewModelStateChanged);
            _vmRef = DotNetObjectReference.Create(VM);
            await VM.OnFirstRenderAsync(_vmRef);
            // Ensure top panels sizing is correct after initial render
            try { await JSRuntime.InvokeVoidAsync("sharpestNavMenu.ensureTopPanelsExpandedToFooter", "top-panels-content", "chat-footer"); } catch { }
            StateHasChanged();
            return;
        }

        if (_vmRef != null)
        {
            try
            {
                _renderCts?.Cancel();
                _renderCts?.Dispose();
                _renderCts = new CancellationTokenSource();
                var token = _renderCts.Token;
                await VM.OnSubsequentRenderAsync(_vmRef, token);
                // Re-evaluate top panels sizing on subsequent renders
                if (!token.IsCancellationRequested)
                    await JSRuntime.InvokeVoidAsync("sharpestNavMenu.ensureTopPanelsExpandedToFooter", token, "top-panels-content", "chat-footer");
            }
            catch (TaskCanceledException) { }
            catch (Microsoft.JSInterop.JSDisconnectedException) { }
            catch (ObjectDisposedException) { }
        }
    }

    public void Dispose()
    {
        // Cancel any in-flight VM render operations before disposing the DotNetObjectReference to avoid races
        try
        {
            _renderCts?.Cancel();
        }
        catch { }
        finally
        {
            _renderCts?.Dispose();
            _renderCts = null;
        }

        VM.UnregisterStateChangeListener(OnViewModelStateChanged);
        _vmRef?.Dispose();
    }

    private void OnViewModelStateChanged()
    {
        _ = InvokeAsync(StateHasChanged);
    }

    private async Task OnModelPrimaryActionClick()
    {
        if (VM.UseWebChatProvider)
        {
            await VM.PrepareWebChatProviderAsync();
            return;
        }

        await VM.ToggleModelAsync();
    }

    private void BeginProtectedZoneNameEdit(HomeViewModel.ClickerProtectedZone zone)
    {
        _editingClickerProtectedZoneId = zone.Id;
        _editingClickerProtectedZoneName = zone.Name;
    }

    private void CommitProtectedZoneNameEdit(Guid zoneId)
    {
        if (_editingClickerProtectedZoneId != zoneId)
        {
            return;
        }

        VM.RenameClickerProtectedZone(zoneId, _editingClickerProtectedZoneName);
        _editingClickerProtectedZoneId = null;
        _editingClickerProtectedZoneName = string.Empty;
    }

    private void CancelProtectedZoneNameEdit(Guid zoneId)
    {
        if (_editingClickerProtectedZoneId != zoneId)
        {
            return;
        }

        _editingClickerProtectedZoneId = null;
        _editingClickerProtectedZoneName = string.Empty;
    }

    private void OnProtectedZoneNameKeyDown(Guid zoneId, KeyboardEventArgs args)
    {
        if (args.Key == "Enter")
        {
            CommitProtectedZoneNameEdit(zoneId);
            return;
        }

        if (args.Key == "Escape")
        {
            CancelProtectedZoneNameEdit(zoneId);
        }
    }

    private void RemoveProtectedZone(Guid zoneId)
    {
        CancelProtectedZoneNameEdit(zoneId);
        VM.RemoveClickerProtectedZone(zoneId);
    }

    private static string ToCssPercent(double value)
    {
        return value.ToString("0.###", CultureInfo.InvariantCulture) + "%";
    }
}
